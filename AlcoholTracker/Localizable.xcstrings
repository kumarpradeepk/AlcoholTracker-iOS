          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels sur l'écran verrouillé ne mentionnent jamais l'alcool."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
