    "set_day_ends_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 1 AM drink counts toward the night before."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A 1am drink counts towards the night before."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Getränk um 1 Uhr zählt zur Nacht davor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深夜1時の一杯は、前の晩に数えます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un verre à 1 h compte pour la nuit précédente."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un verre pris à 1 h compte pour la soirée précédente."
          }
