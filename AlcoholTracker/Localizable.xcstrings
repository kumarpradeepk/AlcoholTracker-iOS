    "stats_units_empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pattern will paint itself here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pattern will paint itself here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier zeichnet sich dein Muster von selbst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに、あなたの傾向が描かれていきます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre schéma se dessinera ici."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton portrait se dessinera ici."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu patrón se irá dibujando aquí."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se irá dibujando tu patrón."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu padrão vai se desenhar aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui il tuo andamento si disegnerà da sé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 패턴이 그려질 거예요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的模式會在這裏自己畫出來。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบการดื่มของคุณจะค่อยๆ ปรากฏขึ้นตรงนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deseniniz kendini burada çizecek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzorzec sam się tu namaluje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit mønster tegner sig selv her."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Polamu akan melukis dirinya sendiri di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Corak anda akan melukis dirinya di sini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito mismo mabubuo ang pattern mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu hình của bạn sẽ tự vẽ nên ở đây."
          }
        }
      }
    },
