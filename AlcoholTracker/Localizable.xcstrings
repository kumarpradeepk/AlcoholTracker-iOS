        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trago a la 1 de la madrugada cuenta para la noche anterior."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copa a la 1:00 cuenta para la noche anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma bebida à 1h conta para a noite anterior."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bicchiere all'1:00 conta per la sera prima."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새벽 1시에 마신 잔은 전날 밤으로 계산돼요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "凌晨 1 時飲的一杯，會算入前一晚。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้วตอนตี 1 จะนับเข้าคืนก่อนหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat 01.00'de içilen bir içki, bir önceki geceye sayılır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink o 1:00 liczy się do poprzedniej nocy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En drink kl. 01.00 tæller med til aftenen før."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
