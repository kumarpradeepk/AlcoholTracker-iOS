    "ob_welcome_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track without judgment. Log a drink in seconds, watch your estimated BAC settle, even from your wrist."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Track without judgement. Log a drink in seconds, watch your estimated BAC settle, even from your wrist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassen ohne Bewertung. Ein Getränk in Sekunden eintragen, den geschätzten BAK-Wert sinken sehen, sogar vom Handgelenk aus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価はしません。数秒で一杯を記録して、推定BACが下がっていくのを、手首からでも見られます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un suivi sans jugement. Enregistrez un verre en quelques secondes et voyez votre alcoolémie estimée redescendre, même depuis votre poignet."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un suivi sans jugement. Inscris un verre en quelques secondes et regarde ton alcoolémie estimée redescendre, même depuis ton poignet."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro sin juicios. Anota un trago en segundos y mira cómo baja tu alcoholemia estimada, incluso desde tu muñeca."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seguimiento sin juicios. Registra una copa en segundos y observa cómo baja tu tasa de alcoholemia estimada, incluso desde la muñeca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre sem julgamento. Anote uma bebida em segundos e acompanhe sua estimativa de álcool no sangue baixar, até do seu pulso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni il conto senza giudizio. Registri un bicchiere in pochi secondi e vedi il tuo tasso alcolemico stimato scendere, anche dal polso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평가하지 않고 기록해요. 한 잔을 몇 초 만에 남기고, 추정 혈중알코올농도가 내려가는 것을 손목에서도 볼 수 있어요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄，不評價。幾秒記下一杯，看着估算的血液酒精濃度慢慢回落，在手腕上也看得到。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกโดยไม่ตัดสิน จดหนึ่งแก้วได้ในไม่กี่วินาที แล้วดูค่าประมาณระดับแอลกอฮอล์ในเลือดค่อยๆ ลดลง ดูจากข้อมือก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yargısız takip. Bir içkiyi saniyeler içinde kaydedin, tahmini kandaki alkol değerinizin düşüşünü izleyin — bileğinizden bile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj bez oceniania. Drink w kilka sekund, szacowany alkohol we krwi opada na twoich oczach — nawet z nadgarstka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrering uden løftet pegefinger. Notér en drink på få sekunder, og se dit estimat falde — også fra håndleddet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat tanpa dinilai. Satu minuman tercatat dalam hitungan detik, perkiraan BAC turun pelan di depan mata, bahkan dari pergelangan tangan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod tanpa penilaian. Catat minuman dalam beberapa saat, lihat anggaran BAC anda menurun, malah dari pergelangan tangan anda."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-track nang walang paghusga. Mag-log ng inom sa ilang segundo, tingnan kung paano bumababa ang tinatayang BAC mo, kahit mula sa wrist mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại mà không phán xét. Ghi một ly trong vài giây, theo dõi ước tính BAC giảm dần, ngay từ cổ tay."
          }
        }
      }
    },
