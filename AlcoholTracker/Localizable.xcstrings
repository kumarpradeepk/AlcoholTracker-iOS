    "pay_faq_a_after": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan you picked starts, at the price shown on its card, never a higher one. We remind you 2 days before, so nothing arrives as a surprise."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan you picked starts, at the price shown on its card, never a higher one. We remind you 2 days before, so nothing arrives as a surprise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann startet genau der Tarif, den du gewählt hast, zu dem Preis auf seiner Karte, nie zu einem höheren. Wir erinnern dich 2 Tage vorher, damit dich nichts überrascht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだプランが、そのカードに表示された価格で始まります。より高い価格になることはありません。2日前にお知らせするので、不意打ちにはなりません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La formule que vous avez choisie démarre, au prix affiché sur sa carte, jamais un prix plus élevé. Nous vous prévenons 2 jours avant, pour que rien n'arrive par surprise."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le forfait que vous avez choisi démarre, au prix affiché sur sa carte, jamais un prix plus élevé. Nous vous prévenons 2 jours avant, pour que rien n'arrive par surprise."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza el plan que elegiste, al precio que aparece en su tarjeta, nunca uno mayor. Te avisamos 2 días antes, para que nada te tome por sorpresa."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza el plan que elegiste, al precio que aparece en su tarjeta, nunca uno mayor. Te avisamos 2 días antes, para que nada te pille por sorpresa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa o plano que você escolheu, pelo preço que aparece no cartão dele, nunca um mais alto. Avisamos 2 dias antes, para nada chegar de surpresa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte il piano che hai scelto, al prezzo indicato sulla sua scheda, mai uno più alto. Ti avvisiamo 2 giorni prima, così niente arriva a sorpresa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 플랜이 그 카드에 적힌 가격으로 시작합니다. 더 비싼 가격이 되는 일은 없습니다. 2일 전에 알려 드리니 갑작스러울 일도 없습니다."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你揀嘅方案就會開始，用佢卡片上顯示嘅價錢，絕對唔會更貴。我哋會提早 2 日提你，唔會嚇你一跳。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพ็กเกจที่คุณเลือกจะเริ่มต้นในราคาที่แสดงบนการ์ดของมัน ไม่มีทางแพงกว่านั้น เราจะเตือนล่วงหน้า 2 วัน จะได้ไม่มีอะไรมาเซอร์ไพรส์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin plan başlar, kartında yazan fiyattan, asla daha yükseğinden değil. 2 gün önce hatırlatırız, hiçbir şey sürpriz olmaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Startuje dokładnie ten plan, który wybrałeś, w cenie z jego karty, nigdy droższy. Przypomnimy 2 dni wcześniej, żeby nic cię nie zaskoczyło."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så starter netop det abonnement, du valgte, til prisen på dets kort, aldrig en højere. Vi minder dig om det 2 dage før, så intet kommer bag på dig."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket yang kamu pilih mulai berjalan, dengan harga yang tertera di kartunya, tidak pernah lebih tinggi. Kami mengingatkan 2 hari sebelumnya, jadi tidak ada yang mengejutkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelan yang anda pilih bermula, pada harga yang tertera pada kadnya, tidak pernah lebih tinggi. Kami ingatkan 2 hari lebih awal, supaya tiada apa yang mengejutkan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsisimula ang plan na pinili mo, sa presyong nakalagay sa card nito, hindi kailanman mas mataas. Papaalalahanan ka namin 2 araw bago, para walang biglaan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói bạn đã chọn bắt đầu, với đúng giá ghi trên thẻ của nó, không bao giờ cao hơn. Chúng tôi nhắc trước 2 ngày, để không có gì bất ngờ."
          }
        }
      }
    },
    "pay_faq_a_cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always. Manage or cancel from your %1$@ subscriptions, and your data stays right here on your phone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Always. Manage or cancel from your %1$@ subscriptions, and your data stays right here on your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer. Verwalte oder kündige in deinen %1$@-Abos, und deine Daten bleiben hier auf deinem Handy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも。%1$@のサブスクリプションから管理または解約でき、データはこの端末に残ります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours. Gérez ou annulez depuis vos abonnements %1$@, et vos données restent ici, sur votre téléphone."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours. Gérez ou annulez depuis vos abonnements %1$@, et vos données restent ici, sur votre téléphone."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre. Gestioná o cancelá desde tus suscripciones de %1$@, y tus datos se quedan acá, en tu teléfono."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre. Gestiona o cancela desde tus suscripciones de %1$@, y tus datos se quedan aquí, en tu móvil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre. Gerencie ou cancele nas suas assinaturas da %1$@, e seus dados ficam aqui, no seu celular."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre. Gestisci o disdici dai tuoi abbonamenti %1$@, e i tuoi dati restano qui, sul tuo telefono."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제나요. %1$@ 구독에서 관리하거나 해지할 수 있고, 데이터는 이 휴대폰에 그대로 남습니다."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠可以。喺你嘅 %1$@ 訂閱度管理或者取消，你嘅數據就留喺呢部電話。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้เสมอ จัดการหรือยกเลิกได้จากการสมัครสมาชิก %1$@ ของคุณ และข้อมูลของคุณยังอยู่ตรงนี้ ในเครื่องของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman. %1$@ aboneliklerinden yönet ya da iptal et, verilerin burada, telefonunda kalır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze. Zarządzaj lub anuluj w swoich subskrypcjach %1$@, a twoje dane zostają tutaj, w telefonie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Altid. Administrer eller afmeld under dine %1$@-abonnementer, og dine data bliver her på din telefon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu. Kelola atau batalkan dari langgananmu di %1$@, dan datamu tetap di sini, di ponselmu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentiasa. Urus atau batalkan daripada langganan %1$@ anda, dan data anda kekal di sini, dalam telefon anda."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Palagi. I-manage o kanselahin mula sa mga subscription mo sa %1$@, at mananatili ang data mo dito, sa telepono mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn luôn. Quản lý hoặc hủy trong phần đăng ký %1$@ của bạn, và dữ liệu vẫn nằm ngay đây, trên điện thoại của bạn."
          }
        }
      }
    },
    "pay_faq_a_logs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No. Logging, custom drinks, this week's stats, widgets, CSV export, backup, dark mode, app lock and reminders are free forever. Stop paying and everything you wrote stays yours, and stays readable."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No. Logging, custom drinks, this week's stats, widgets, CSV export, backup, dark mode, app lock and reminders are free forever. Stop paying and everything you wrote stays yours, and stays readable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein. Erfassen, eigene Getränke, die Statistik dieser Woche, Widgets, CSV-Export, Sicherung, Dunkelmodus, App-Sperre und Erinnerungen sind für immer gratis. Hörst du auf zu zahlen, bleibt alles Geschriebene deins und bleibt lesbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありません。記録、カスタムドリンク、今週の統計、ウィジェット、CSV書き出し、バックアップ、ダークモード、アプリロック、リマインダーはずっと無料です。支払いをやめても、書いたものはすべてあなたのもので、読める状態のまま残ります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non. La saisie, les boissons perso, les stats de la semaine, les widgets, l'export CSV, la sauvegarde, le mode sombre, le verrouillage et les rappels sont gratuits pour toujours. Si vous arrêtez de payer, tout ce que vous avez écrit reste à vous, et reste lisible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Non. La saisie, les boissons personnalisées, les stats de la semaine, les widgets, l'exportation CSV, la sauvegarde, le mode sombre, le verrouillage et les rappels sont gratuits pour toujours. Si vous cessez de payer, tout ce que vous avez écrit reste à vous, et reste lisible."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No. El registro, las bebidas propias, las estadísticas de esta semana, los widgets, la exportación CSV, el respaldo, el modo oscuro, el bloqueo y los recordatorios son gratis para siempre. Si dejás de pagar, todo lo que escribiste sigue siendo tuyo y sigue siendo legible."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No. El registro, las bebidas propias, las estadísticas de esta semana, los widgets, la exportación CSV, la copia, el modo oscuro, el bloqueo y los recordatorios son gratis para siempre. Si dejas de pagar, todo lo que escribiste sigue siendo tuyo y sigue siendo legible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não. Registro, bebidas próprias, as estatísticas desta semana, widgets, exportação CSV, backup, modo escuro, bloqueio e lembretes são grátis para sempre. Se você parar de pagar, tudo o que escreveu continua seu e continua legível."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No. Registrazione, bevande personali, le statistiche di questa settimana, widget, esportazione CSV, backup, modo scuro, blocco app e promemoria sono gratis per sempre. Se smetti di pagare, tutto quello che hai scritto resta tuo e resta leggibile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "없습니다. 기록, 나만의 음료, 이번 주 통계, 위젯, CSV 내보내기, 백업, 다크 모드, 앱 잠금, 알림은 영원히 무료입니다. 결제를 멈춰도 적어 둔 모든 것은 그대로 내 것이고, 그대로 읽을 수 있습니다."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "唔會。紀錄、自訂飲品、今個星期嘅統計、小工具、CSV 匯出、備份、深色模式、應用程式鎖同提醒永遠免費。就算你唔再付款，你寫低嘅一切依然係你嘅，依然睇得到。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ การบันทึก เครื่องดื่มของคุณเอง สถิติสัปดาห์นี้ วิดเจ็ต การส่งออก CSV การสำรองข้อมูล โหมดมืด ล็อกแอป และการเตือน ฟรีตลอดไป ถ้าคุณหยุดจ่าย ทุกอย่างที่คุณเขียนไว้ยังเป็นของคุณและยังอ่านได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayır. Kayıt, kendi içkilerin, bu haftanın istatistikleri, widget'lar, CSV dışa aktarma, yedek, koyu mod, uygulama kilidi ve hatırlatmalar sonsuza dek ücretsiz. Ödemeyi bırakırsan yazdığın her şey senin kalır ve okunabilir kalır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie. Zapisywanie, własne drinki, statystyki tego tygodnia, widżety, eksport CSV, kopia zapasowa, tryb ciemny, blokada aplikacji i przypomnienia są darmowe na zawsze. Jeśli przestaniesz płacić, wszystko, co zapisałeś, zostaje twoje i zostaje czytelne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nej. Notering, egne drikkevarer, denne uges statistik, widgets, CSV-eksport, sikkerhedskopi, mørk tilstand, app-lås og påmindelser er gratis for altid. Holder du op med at betale, bliver alt, du har skrevet, ved med at være dit og ved med at kunne læses."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak. Pencatatan, minuman sendiri, statistik minggu ini, widget, ekspor CSV, cadangan, mode gelap, kunci aplikasi, dan pengingat gratis selamanya. Kalau kamu berhenti bayar, semua yang kamu tulis tetap milikmu dan tetap bisa dibaca."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak. Rekod, minuman sendiri, statistik minggu ini, widget, eksport CSV, sandaran, mod gelap, kunci apl dan peringatan percuma selamanya. Jika anda berhenti membayar, segala yang anda tulis kekal milik anda dan kekal boleh dibaca."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi. Ang pag-log, sariling inumin, stats ngayong linggo, widgets, CSV export, backup, dark mode, app lock at mga paalala ay libre habambuhay. Kung tumigil kang magbayad, mananatiling sa iyo at mananatiling nababasa ang lahat ng isinulat mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không. Ghi chép, đồ uống riêng, thống kê tuần này, widget, xuất CSV, sao lưu, chế độ tối, khóa ứng dụng và nhắc nhở miễn phí mãi mãi. Nếu bạn ngừng trả tiền, mọi thứ bạn đã ghi vẫn là của bạn và vẫn đọc được."
          }
        }
      }
    },
    "pay_faq_a_trial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Pro feature is yours for %1$d days. Cancel any time before it ends and nothing is charged."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Pro feature is yours for %1$d days. Cancel any time before it ends and nothing is charged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d Tage lang gehören dir alle Pro-Funktionen. Kündige jederzeit vorher, und es wird nichts abgebucht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d日間、Proの機能はすべてあなたのものです。終了前ならいつでも解約でき、料金は一切かかりません。"
          }
        },
