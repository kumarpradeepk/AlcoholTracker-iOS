    "quicklog_empty_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create one and it can live one tap away, up to four fit."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Create one and it can live one tap away, up to four fit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg eines an, dann liegt es einen Tipp entfernt, bis zu vier passen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作っておくと、ワンタップの場所に置けます。4つまで入ります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez-en une et elle tiendra à une touche, quatre au maximum."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Crées-en un et il vivra à une touche de distance. Quatre entrent au maximum."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea uno y quedará a un solo toque; caben hasta cuatro."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una y la tendrás a un toque; caben hasta cuatro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma e ela fica a um toque de distância; cabem até quatro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creane una e la tieni a un tocco di distanza, ce ne stanno fino a quattro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 만들면 한 번 탭으로 기록할 수 있어요. 최대 네 개까지 들어가요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "建立一款，就可以一下記好，最多放得下四款。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างสักรายการ แล้วมันจะอยู่ห่างแค่แตะเดียว ใส่ได้สูงสุดสี่รายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tane oluşturun, tek dokunuş uzağınızda dursun; dörde kadar sığıyor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz jednego, a będzie o jedno dotknięcie stąd — mieszczą się cztery."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en, så ligger den ét tryk væk — der er plads til fire."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat satu dan ia bisa tinggal sejauh satu ketukan, muat sampai empat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta satu dan ia berada satu ketikan sahaja, sehingga empat muat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumawa ng isa at isang tap na lang ito ang layo, hanggang apat ang kasya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo một mục và nó nằm cách bạn một lần chạm, tối đa bốn ô."
          }
        }
      }
    },
