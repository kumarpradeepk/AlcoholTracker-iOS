        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo diario del bere consapevole."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "있는 그대로 보는 음주 기록장."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如實記下每一杯的小本子。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมุดจดที่บอกตามจริงว่าดื่มไปเท่าไหร่"
          }
        },
        "tr": {
          "stringUnit": {
