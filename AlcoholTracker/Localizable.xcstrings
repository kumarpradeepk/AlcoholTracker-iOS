            "state": "translated",
            "value": "Pile sur ta cible. Un verre d'eau ?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Justo en tu objetivo, ¿un vaso de agua ahora?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Justo en tu objetivo, ¿un vaso de agua ahora?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exatamente na meta. Que tal um copo d'água agora?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esattamente sull'obiettivo. Un bicchiere d'acqua?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "딱 목표만큼이에요. 다음은 물 한 잔 어때요?"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "剛好到目標，下一杯來點水？"
