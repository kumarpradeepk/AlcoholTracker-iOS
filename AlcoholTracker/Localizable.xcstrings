        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พอดีเป้าหมายเลย ต่อด้วยน้ำเปล่าสักแก้วไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam hedefinizdesiniz; sırada bir bardak su var mı?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokładnie na celu — może teraz szklanka wody?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Præcis på dagens mål — et glas vand som det næste?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepat di target, segelas air setelah ini?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepat pada sasaran anda, segelas air selepas ini?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa target mo mismo, isang basong tubig kaya ang sunod?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vừa đúng mục tiêu, một ly nước tiếp theo nhé?"
          }
        }
      }
    },
