    "notif_empty_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your evenings are your own. If a gentle daily nudge would help, add one below."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your evenings are your own. If a gentle daily nudge would help, add one below."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Abende gehören dir. Wenn ein leiser täglicher Hinweis hilft, leg unten einen an."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜はあなたのものです。毎日そっと知らせてくれるものが役に立ちそうなら、下から追加してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos soirées vous appartiennent. Si un rappel quotidien tout doux peut aider, ajoutez-en un ci-dessous."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes soirées t'appartiennent. Si un rappel quotidien discret peut aider, ajoutes-en un ci-dessous."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus noches son tuyas. Si un recordatorio diario y suave te sirve, agrega uno abajo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tardes son tuyas. Si te viene bien un aviso diario discreto, añádelo aquí abajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas noites são suas. Se um lembrete diário e leve ajudar, adicione um abaixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue serate sono tue. Se un promemoria quotidiano discreto può aiutare, aggiungine uno qui sotto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저녁은 온전히 내 것이에요. 하루 한 번 가벼운 알림이 도움이 된다면 아래에서 추가해 보세요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "晚上是你自己的。如果每日一下溫和的提醒有幫助，可以在下面加一個。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเย็นเป็นของคุณ ถ้าการเตือนเบาๆ วันละครั้งช่วยได้ เพิ่มได้ด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşamlarınız size ait. Nazik bir günlük hatırlatma işinize yararsa aşağıdan ekleyin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieczory należą do ciebie. Jeśli łagodne codzienne przypomnienie miałoby pomóc, dodaj je poniżej."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine aftener er dine egne. Hvis et stille dagligt skub hjælper, så tilføj et nedenfor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Malammu adalah milikmu. Kalau pengingat harian yang lembut membantu, tambahkan satu di bawah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petang anda milik anda sendiri. Jika satu peringatan harian yang lembut membantu, tambah satu di bawah."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa iyo ang mga gabi mo. Kung makakatulong ang banayad na paalala araw-araw, magdagdag ng isa sa ibaba."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buổi tối là của bạn. Nếu một lời nhắc nhẹ nhàng mỗi ngày có ích, hãy thêm ở dưới."
          }
        }
      }
    },
