    "log_custom_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any volume, any ABV, never behind a paywall."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Any volume, any ABV, never behind a paywall."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Menge, jeder Alkoholgehalt, nie hinter einer Bezahlschranke."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな量でも、どんな度数でも。ここに課金の壁はありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'importe quel volume, n'importe quel degré, jamais payant."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "N'importe quel volume, n'importe quel taux, jamais payant."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier volumen, cualquier graduación, nunca de pago."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier volumen, cualquier graduación, nunca de pago."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer volume, qualquer teor alcoólico, sempre liberado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi volume, qualsiasi gradazione, mai a pagamento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량도 도수도 자유롭게. 유료 기능이 아니에요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "任何份量、任何酒精度，永遠不收費。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปริมาณเท่าไหร่ก็ได้ ดีกรีเท่าไหร่ก็ได้ ไม่เคยต้องจ่ายเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğiniz hacim, istediğiniz alkol oranı — hiçbir zaman ücretli değil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dowolna objętość, dowolna moc — nigdy za opłatą."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhver mængde, enhver alkoholprocent — aldrig bag en betalingsmur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa pun volumenya, berapa pun kadarnya, tidak pernah dikunci."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa-apa isi padu, apa-apa ABV, tidak pernah berbayar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahit anong volume, kahit anong ABV, hindi kailanman nasa likod ng paywall."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ dung tích nào, bất kỳ độ cồn nào, không bao giờ phải trả phí."
          }
        }
      }
    },
