    "sheet_health_data_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only alcohol consumption entries are written, nothing is read."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only alcohol consumption entries are written, nothing is read."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden ausschließlich Einträge zum Alkoholkonsum geschrieben, gelesen wird nichts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込むのはアルコール摂取の記録だけで、読み取りは一切しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les consommations d'alcool sont écrites, rien n'est lu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les consommations d'alcool sont écrites. Rien n'est lu."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se escriben los consumos de alcohol; no se lee nada."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se escriben los registros de consumo de alcohol; no se lee nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os registros de consumo de álcool são gravados. Nada é lido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono scritte solo le voci di consumo di alcol, non viene letto nulla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알코올 섭취 기록만 쓰고, 아무것도 읽지 않아요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只會寫入飲酒記錄，不會讀取任何資料。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนเฉพาะรายการการดื่มแอลกอฮอล์เท่านั้น ไม่มีการอ่านข้อมูลใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca alkol tüketimi kayıtları yazılır; hiçbir şey okunmaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisywane są wyłącznie wpisy o spożyciu alkoholu — nic nie jest odczytywane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der skrives kun poster om alkoholindtag, og der læses ingenting."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya catatan konsumsi alkohol yang ditulis, tidak ada yang dibaca."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya catatan pengambilan alkohol ditulis, tiada apa-apa dibaca."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga tala lang ng pag-inom ng alak ang isinusulat, walang binabasa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ ghi các mục về lượng cồn tiêu thụ, không đọc bất cứ thứ gì."
          }
        }
      }
    },
