    "set_bac_disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates are informational only. Never use them to decide whether it's safe to drive."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates are informational only. Never use them to decide whether it's safe to drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzwerte dienen nur der Information. Entscheide niemals anhand dieser Werte, ob du fahrtüchtig bist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定値はあくまで参考です。運転できるかどうかの判断に使っては絶対にいけません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces estimations sont purement informatives. Ne vous en servez jamais pour décider de prendre le volant."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces estimations sont informatives seulement. Ne t'en sers jamais pour décider de prendre le volant. Dans le doute, ne conduis pas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones son solo informativas. Nunca las uses para decidir si te pones al volante."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones son solo informativas. No las uses nunca para decidir si ponerte al volante. Ante la duda, no conduzcas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As estimativas são apenas informativas. Nunca as use para decidir se pode dirigir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stime sono solo informative. Non usarle mai per decidere se metterti alla guida. Nel dubbio, non guidare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추정치는 참고용일 뿐이에요. 운전해도 되는지를 판단하는 데 절대 쓰지 마세요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "估算值只供參考。絕對不要用來判斷可不可以駕駛。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าประมาณมีไว้ดูเท่านั้น ห้ามใช้ตัดสินว่าขับรถได้หรือไม่ โดยเด็ดขาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahminler yalnızca bilgi içindir. Araç kullanıp kullanamayacağınıza karar vermek için asla kullanmayın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunki mają charakter wyłącznie informacyjny. Nigdy nie opieraj na nich decyzji o prowadzeniu pojazdu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimater er kun til information. Brug dem aldrig til at afgøre, om det er forsvarligt at køre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan ini hanya informasi. Jangan pernah memakainya untuk memutuskan apakah aman menyetir."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggaran ini maklumat sahaja. Jangan sekali-kali gunakannya untuk memutuskan sama ada selamat memandu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Impormasyon lang ang mga tantiya. Huwag na huwag itong gamitin para magpasya kung ligtas nang mag-drive."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số liệu chỉ mang tính tham khảo. Tuyệt đối không dùng chúng để quyết định có lái xe hay không. Đã uống rượu bia thì không lái xe."
          }
        }
      }
    },
    "set_bac_preview_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quiet ongoing notification, while BAC settles."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The quiet ongoing notification, while BAC settles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ruhige laufende Benachrichtigung, während der BAK-Wert sinkt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BACが下がっていくあいだの、静かな進行中の通知。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La notification persistante discrète, pendant que l'alcoolémie redescend."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La notification persistante discrète, pendant que l'alcoolémie redescend."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La notificación discreta en curso, mientras baja la alcoholemia."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La notificación discreta que se queda mientras baja la alcoholemia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A notificação contínua e discreta, enquanto o álcool no sangue baixa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La notifica persistente e discreta, mentre il tasso alcolemico scende."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추정치가 내려가는 동안 조용히 남아 있는 알림이에요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "估算值回落期間，那張安靜的持續通知。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนเงียบๆ ที่ค้างไว้ ระหว่างที่ค่าประมาณค่อยๆ ลดลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandaki alkol düşerken duran sessiz kalıcı bildirim."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciche stałe powiadomienie, dopóki alkohol we krwi spada."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den stille vedvarende notifikation, mens estimatet falder."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi berjalan yang tenang, selama perkiraan BAC turun."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan berterusan yang senyap, sementara BAC menurun."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang tahimik na tuloy-tuloy na notification, habang bumababa ang BAC."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo thường trực lặng lẽ, trong lúc BAC giảm dần."
          }
        }
      }
    },
