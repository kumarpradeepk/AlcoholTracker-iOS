          "stringUnit": {
            "state": "translated",
            "value": "Toutes les fonctions Pro sont à vous pendant %1$d jours. Annulez avant la fin et rien n'est débité."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les fonctions Pro sont à vous pendant %1$d jours. Annulez avant la fin et rien n'est facturé."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las funciones Pro son tuyas durante %1$d días. Cancelá antes de que termine y no se cobra nada."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las funciones Pro son tuyas durante %1$d días. Cancela antes de que acabe y no se cobra nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os recursos Pro são seus por %1$d dias. Cancele antes do fim e nada é cobrado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le funzioni Pro sono tue per %1$d giorni. Disdici prima della fine e non ti viene addebitato nulla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d일 동안 모든 Pro 기능이 내 것입니다. 끝나기 전 언제든 해지하면 아무것도 청구되지 않습니다."
          }
        },
