    "sheet_units_density_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0.789 is just alcohol's density. Nothing mystical."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "0.789 is just alcohol's density. Nothing mystical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0,789 ist einfach die Dichte von Alkohol. Nichts Mystisches."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0.789は、ただのアルコールの密度です。神秘的なものではありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0,789, c'est simplement la densité de l'alcool. Rien de mystérieux."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "0,789, c'est juste la densité de l'alcool. Rien de mystérieux là-dedans."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "0.789 es simplemente la densidad del alcohol. Nada místico."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "0,789 es solo la densidad del alcohol. Nada esotérico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "0,789 é só a densidade do álcool. Nada de místico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "0,789 è semplicemente la densità dell'alcol. Niente di misterioso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0.789은 그냥 알코올의 밀도예요. 신비로울 것 없어요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "0.789 只是酒精的密度，沒有甚麼玄機。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "0.789 ก็แค่ความหนาแน่นของแอลกอฮอล์ ไม่มีอะไรลึกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0,789 yalnızca alkolün yoğunluğu. Gizemli bir yanı yok."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "0,789 to po prostu gęstość alkoholu. Nic mistycznego."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "0,789 er bare alkohols massefylde. Intet mystisk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "0,789 itu hanya massa jenis alkohol. Tidak ada yang mistis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "0.789 hanyalah ketumpatan alkohol. Tiada apa-apa yang misteri."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Density lang ng alkohol ang 0.789. Walang mahika riyan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "0,789 chỉ là khối lượng riêng của cồn. Không có gì huyền bí."
          }
        }
      }
    },
    "sheet_units_targets": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's one margarita, quietly a unit and a half. Your daily and weekly targets start at the WHO low-risk guideline, and they're yours to move."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "That's one margarita, quietly a %1$@ and a half. Your daily and weekly targets start at the WHO low-risk guideline, and they're yours to move."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine Margarita, still und leise anderthalb %1$@. Deine Tages- und Wochenziele starten bei der WHO-Empfehlung für risikoarmen Konsum, und du kannst sie jederzeit verschieben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マルガリータ1杯で、さりげなく1.5%1$@です。1日と1週間の目標は、WHOの低リスク指針を出発点にしています。あとは自由に動かせます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une margarita, et voilà déjà %1$@. Vos objectifs quotidien et hebdomadaire partent du repère de moindre risque de l'OMS, libre à vous de les ajuster."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça, c'est une margarita — discrètement %1$@. Tes cibles quotidienne et hebdomadaire partent du repère de moindre risque de l'OMS, et elles t'appartiennent."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una margarita, y ahí van ya %1$@. Tus objetivos diario y semanal parten de la referencia de bajo riesgo de la OMS, y son tuyos para moverlos."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es un margarita, que discretamente suma %1$@. Tus objetivos diario y semanal parten de la recomendación de bajo riesgo de la OMS, y puedes moverlos a tu gusto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é uma margarita — discretamente uma %1$@ e meia. Suas metas diária e semanal partem da diretriz de baixo risco da OMS, e são suas para ajustar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cioè una margarita, che in silenzio vale %1$@. I tuoi obiettivi giornaliero e settimanale partono dal riferimento OMS a basso rischio, e puoi spostarli come vuoi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마가리타 한 잔, 조용히 %1$@ 1.5예요. 하루 목표와 주간 목표는 WHO 저위험 기준에서 시작하고, 옮기는 건 언제나 내 몫이에요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "那是一杯 Margarita，靜靜地就是一個半%1$@。你的每日和每星期目標，由世衞低風險指引起步，之後怎樣調，都是你的事。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นั่นคือ Margarita หนึ่งแก้ว เท่ากับ 1.5 %1$@ แบบเงียบๆ เป้าหมายรายวันและรายสัปดาห์เริ่มต้นจากแนวทางความเสี่ยงต่ำขององค์การอนามัยโลก และคุณขยับมันได้เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir margarita, sessizce bir buçuk %1$@ eder. Günlük ve haftalık hedefleriniz DSÖ'nün düşük riskli rehberinden başlar; dilediğiniz gibi değiştirebilirsiniz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jedna Margarita — po cichu półtorej jednostki. Cel dzienny i tygodniowy startują od wytycznych WHO dotyczących niskiego ryzyka i można je dowolnie przesunąć."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er én margarita — ganske stille halvanden genstand. Dine daglige og ugentlige mål starter ved WHO's retningslinje for lav risiko, og de er dine at flytte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu satu Margarita, diam-diam 1,5 %1$@. Target harian dan mingguanmu dimulai dari pedoman risiko rendah WHO, dan kamu bebas menggesernya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu satu Margarita, diam-diam bernilai 1.5 %1$@. Sasaran harian dan mingguan anda bermula pada garis panduan risiko rendah WHO, dan anda bebas mengubahnya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isa iyang margarita, tahimik na isa't kalahating %1$@. Ang pang-araw-araw at lingguhang target mo ay nagsisimula sa mababang-panganib na guideline ng WHO, at ikaw ang may hawak kung ililipat mo ang mga ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là một ly Margarita, lặng lẽ bằng một %1$@ rưỡi. Mục tiêu ngày và tuần của bạn khởi đầu từ khuyến nghị nguy cơ thấp của WHO, và bạn toàn quyền dịch chuyển."
          }
        }
      }
    },
