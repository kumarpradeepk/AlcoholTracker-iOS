    "log_pick_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What did you have? Pick close enough, you can fine-tune everything next."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What did you have? Pick close enough, you can fine-tune everything next."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hattest du? Nimm etwas, das ungefähr passt, alles Weitere justierst du gleich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を飲みましたか? 近いものを選べば大丈夫です。細かいところは次で調整できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'avez-vous bu ? Choisissez au plus proche, tout s'affine à l'étape suivante."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que tu as pris ? Choisis ce qui s'en approche, tu ajusteras tout à l'étape suivante."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué tomaste? Elige lo más parecido; todo se ajusta en el siguiente paso."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué has tomado? Elige lo más parecido; luego puedes ajustarlo todo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você tomou? Escolha algo parecido, dá para ajustar tudo na próxima etapa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa hai bevuto? Scegli qualcosa di simile, poi regoli tutto al passaggio dopo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뭘 드셨어요? 비슷한 걸로 고르면 돼요. 자세한 건 다음 단계에서 맞출 수 있어요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "飲了甚麼？揀個相近的就可以，下一步再慢慢調。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดื่มอะไรไป เลือกอันที่ใกล้เคียงก็พอ เดี๋ยวค่อยปรับละเอียดในขั้นถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne içtiniz? Yakın olan bir şey seçin; sonraki adımda her şeye ince ayar yapabilirsiniz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co to było? Wystarczy coś zbliżonego — wszystko można doprecyzować w następnym kroku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad fik du? Vælg noget, der er tæt nok på — du kan finjustere alt bagefter."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minum apa tadi? Pilih yang paling mendekati, semuanya bisa disesuaikan di langkah berikutnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang anda minum? Pilih yang hampir sama, semuanya boleh diperhalusi selepas ini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano ang ininom mo? Pumili ng malapit na, maaayos mo ang lahat sa susunod."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã uống gì? Chọn gần đúng là được, bước sau tinh chỉnh lại hết."
          }
        }
      }
    },
