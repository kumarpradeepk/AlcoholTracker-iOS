    "diary_remaining_zero_neutral": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your full allowance is untouched, or simply not needed today."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your full allowance is untouched, or simply not needed today."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Tagesrahmen ist unangetastet, oder heute einfach nicht nötig."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の枠はそのままです。あるいは、今日は必要ないのかもしれません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objectif du jour intact, ou tout simplement pas utile aujourd'hui."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta cible du jour est intacte, ou simplement pas nécessaire aujourd'hui."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu objetivo del día sigue intacto, o simplemente hoy no hace falta."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El margen del día sigue intacto, o simplemente hoy no hace falta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua margem do dia está intacta — ou simplesmente não fez falta hoje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il margine di oggi è ancora intero, o semplicemente non serve."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 목표는 그대로 남아 있어요. 굳이 쓰지 않아도 되고요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "今日的目標一點未動，又或者，今日根本不需要。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป้าหมายวันนี้ยังไม่ถูกแตะเลย หรือวันนี้อาจไม่จำเป็นต้องใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü hedefiniz olduğu gibi duruyor; belki de bugün gerekmedi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cały dzienny cel nietknięty — albo po prostu dziś niepotrzebny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagens ramme står urørt — eller er måske slet ikke nødvendig i dag."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Target hari ini belum tersentuh, atau memang tidak diperlukan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasaran anda masih penuh, atau memang tidak diperlukan hari ini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa nagagalaw ang target mo ngayong araw, o hindi mo lang ito kailangan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục tiêu hôm nay còn nguyên, hoặc đơn giản là hôm nay không cần đến."
