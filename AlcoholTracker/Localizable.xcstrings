            "value": "Tahmini kandaki alkol, sıfıra kalan süre ve kalıcı durum kartı."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacowany alkohol we krwi, czas do zera i stała karta statusu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimeret promille, tid til nul og det vedvarende statuskort."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan BAC, waktu menuju nol, dan kartu status berjalan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggaran BAC, masa ke sifar, dan kad status berterusan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinatayang BAC, oras bago maging zero, at ang tuloy-tuloy na status card."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước tính BAC, thời gian về 0 và thẻ trạng thái thường trực."
