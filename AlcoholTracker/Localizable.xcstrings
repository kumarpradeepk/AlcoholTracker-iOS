    "set_tone_sub_neutral": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers and gentle acknowledgement, never judgment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers and gentle acknowledgement, never judgement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlen und ein leises Nicken, nie ein Urteil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字と、そっとしたうなずき。評価はしません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des chiffres et un mot bienveillant, jamais de jugement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Des chiffres et une reconnaissance discrète, jamais de jugement."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Números y un reconocimiento amable, nunca juicios."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Números y un reconocimiento discreto, nunca juicios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Números e um reconhecimento gentil, nunca julgamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Numeri e un riconoscimento discreto, mai un giudizio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자와 부드러운 인정, 평가는 없어요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "數字，加一點溫和的認可，從不評價。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลข กับการรับรู้แบบอ่อนโยน ไม่ตัดสิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayılar ve yumuşak bir onay; asla yargı yok."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczby i łagodne potwierdzenie, nigdy ocena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal og en stille anerkendelse, aldrig en dom."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka dan pengakuan yang lembut, tidak pernah penilaian."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombor dan pengiktirafan lembut, tidak sekali-kali penilaian."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga numero at banayad na pagkilala, hindi kailanman paghusga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con số và sự ghi nhận nhẹ nhàng, không phán xét."
          }
        }
      }
    },
    "set_tone_sub_numbers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pure ledger, every evaluative word and colour-judgment suppressed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pure ledger, every evaluative word and colour-judgement suppressed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reines Kontobuch, jedes wertende Wort und jede Farbwertung unterdrückt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "純粋な記録だけ。評価の言葉も、色による判定も出しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre brut, tout mot évaluatif et tout jugement de couleur supprimés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre pur : tout mot d'évaluation et tout jugement de couleur sont supprimés."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro puro: se elimina toda palabra evaluativa y todo juicio de color."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el registro: sin una sola palabra de valoración ni juicio de color."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o registro: toda palavra de avaliação e todo julgamento por cor suprimidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo registro: nessuna parola di giudizio, nessun colore che valuta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순수한 장부. 평가하는 말과 색 판단을 모두 없앤 모드예요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "純粹的帳目，所有評價字眼和顏色判斷都會收起。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีล้วนๆ ตัดคำที่ตัดสินและการตัดสินด้วยสีออกทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saf defter; her değerlendirme sözcüğü ve renk yargısı kapalı."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysty rejestr — bez słów oceny i bez oceny kolorem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rent regnskab — hvert vurderende ord og hver farvedom er slået fra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Murni catatan angka, setiap kata penilaian dan penghakiman lewat warna dimatikan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejar semata-mata, setiap perkataan penilaian dan pertimbangan warna dimatikan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Purong talaan, walang anumang salitang naghuhusga at walang paghatol sa pamamagitan ng kulay."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thuần sổ sách, ẩn mọi từ đánh giá và mọi phán xét bằng màu sắc."
          }
        }
      }
    },
    "set_tone_sub_push": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak-forward, with stronger over-target emphasis."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak-forward, with stronger over-target emphasis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serien im Vordergrund, mit deutlicherem Hinweis über dem Ziel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続日数を前に出し、目標を超えたときははっきり示します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Axé sur les séries, avec un dépassement d'objectif plus appuyé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Axé sur les séries, avec plus d'insistance au-delà de la cible."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfocado en las rachas, con más énfasis al pasar el objetivo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Con las rachas por delante y más énfasis al pasar del objetivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco nas sequências, com ênfase maior quando passa da meta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta sulle serie, con più enfasi quando superi l'obiettivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속 기록 중심, 목표 초과는 더 또렷하게."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "以連續紀錄為主，超出目標時強調得更明顯。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เน้นวันต่อเนื่อง และเน้นตอนเกินเป้าหมายให้ชัดขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seri odaklı; hedef aşıldığında daha belirgin vurgu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacisk na serie i mocniejsze podkreślenie przekroczeń."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus på stimer og tydeligere markering, når målet overskrides."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengedepankan rentetan, dengan penekanan lebih kuat saat melewati target."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengutamakan rentetan, dengan penegasan lebih kuat apabila melebihi sasaran."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-pokus sa streak, mas malakas ang diin kapag lampas sa target."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề cao chuỗi ngày, nhấn mạnh hơn khi vượt mục tiêu."
          }
        }
      }
    },
