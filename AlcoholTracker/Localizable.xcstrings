    "stats_breakdown_locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See which drinks lead your weeks, and what they quietly add up to."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "See which drinks lead your weeks, and what they quietly add up to."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, welche Getränke deine Wochen anführen und was dabei still zusammenkommt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのお酒があなたの1週間を引っぱっているのか、静かにどれだけ積み上がっているのかが見えます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez quelles boissons mènent vos semaines, et ce qu'elles finissent par représenter."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vois quels verres mènent tes semaines, et ce qu'ils finissent par représenter."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué bebidas encabezan tus semanas y a cuánto llegan sin que lo notes."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre qué bebidas encabezan tus semanas y lo que suman sin hacer ruido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja quais bebidas puxam suas semanas e quanto elas somam sem alarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri quali bevande guidano le tue settimane e quanto fanno, in silenzio, sommate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 술이 한 주를 이끄는지, 그리고 조용히 얼마나 쌓이는지 볼 수 있어요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "看看哪一款飲品主導你的星期，以及它們靜靜地累積成甚麼。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูว่าเครื่องดื่มไหนนำในแต่ละสัปดาห์ และมันสะสมเป็นเท่าไหร่แบบเงียบๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalarınıza hangi içkilerin yön verdiğini ve sessizce ne kadar tuttuğunu görün."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, które drinki prowadzą w twoich tygodniach i ile po cichu składają się na całość."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hvilke drinks der fylder mest i dine uger, og hvad de stille og roligt løber op i."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat minuman apa yang memimpin minggu-minggumu, dan berapa jumlahnya diam-diam."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat minuman mana yang mendahului minggu anda, dan berapa jumlahnya secara senyap."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingnan kung aling inumin ang nangunguna sa mga linggo mo, at kung ano ang tahimik nilang kinalalabasan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem đồ uống nào dẫn đầu các tuần của bạn, và chúng lặng lẽ cộng lại thành bao nhiêu."
          }
        }
      }
    },
