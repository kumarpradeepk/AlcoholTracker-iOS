          "stringUnit": {
            "state": "translated",
            "value": "Your mindful drinking companion."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your mindful drinking companion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Begleiter für bewussten Alkoholkonsum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飲む量と向き合うための、あなたの相棒。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compagnon pour boire en conscience."
          }
        },
        "fr-CA": {
