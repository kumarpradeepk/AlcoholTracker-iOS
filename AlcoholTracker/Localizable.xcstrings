    "dialog_health_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow \"%1$@\" to write alcohol consumption to %2$@?"
          }
        },
        "en-GB": {
          "stringUnit": {
