    "backup_clear_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanent, and it cannot be undone. Export a copy first if it matters."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanent, and it cannot be undone. Export a copy first if it matters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig, und es lässt sich nicht rückgängig machen. Exportiere vorher eine Kopie, falls es dir wichtig ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に削除され、元には戻せません。大事なものなら、先に書き出しておいてください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définitif, et impossible à annuler. Exportez une copie d'abord si cela compte."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Définitif, et impossible à annuler. Exporte une copie d'abord si ça compte."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Es permanente y no se puede deshacer. Exporta una copia antes si te importa."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Es permanente y no se puede deshacer. Si te importa, exporta una copia antes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É permanente e não dá para desfazer. Exporte uma cópia antes, se isso importa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È definitivo e non si può annullare. Se ci tieni, esporta prima una copia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영구적이고, 되돌릴 수 없어요. 소중하다면 먼저 사본을 내보내세요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "永久生效，無法還原。如果重要，先匯出一份。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถาวร และย้อนกลับไม่ได้ ถ้ามันสำคัญ ส่งออกสำเนาไว้ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıcıdır ve geri alınamaz. Önemliyse önce bir kopyasını dışa aktarın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieodwracalne. Nie da się tego cofnąć. Najpierw wyeksportuj kopię, jeśli dane mają znaczenie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanent, og det kan ikke fortrydes. Eksporter en kopi først, hvis det betyder noget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanen, dan tidak bisa dibatalkan. Ekspor salinannya dulu kalau itu penting."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekal, dan tidak boleh dibatalkan. Eksport satu salinan dahulu jika ia penting."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanente ito, at hindi na maibabalik. Mag-export muna ng kopya kung mahalaga ito sa iyo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vĩnh viễn và không thể hoàn tác. Hãy xuất một bản sao trước nếu dữ liệu còn quan trọng."
          }
        }
      }
    },
