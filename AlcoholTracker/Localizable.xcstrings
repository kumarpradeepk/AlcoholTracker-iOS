    "guideline_monthly_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your monthly target follows automatically: %1$d units. The WHO guideline is a source, not a verdict."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your monthly target follows automatically: %1$d %2$@. The WHO guideline is a source, not a verdict."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Monatsziel ergibt sich automatisch: %1$d %2$@. Die WHO-Empfehlung ist eine Quelle, kein Urteil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1か月の目標は自動で決まります: %1$d%2$@。WHOの指針は出典であって、判定ではありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre objectif mensuel suit automatiquement : %1$d %2$@. Le repère de l'OMS est une référence, pas un verdict."
          }
        },
