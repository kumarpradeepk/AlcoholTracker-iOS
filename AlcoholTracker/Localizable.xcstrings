    "stats_dry_body_none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first one starts a streak, mark today dry from the Diary."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The first one starts a streak, mark today drink-free from the Diary."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste beginnt eine Serie, markiere heute im Tagebuch als alkoholfrei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の一日から続きが始まります。日記から今日を休肝日にできます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier lance la série, marquez la journée sans alcool depuis le Journal."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier lance la série : marque la journée sans alcool depuis le Journal."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El primero arranca una racha; marca hoy como día sin alcohol desde el Diario."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El primero empieza una racha; puedes marcar hoy desde el Diario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro começa uma sequência. Marque hoje pelo Diário."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo fa partire una serie: segna oggi dal Diario."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 하루가 연속 기록의 시작이에요. 기록 탭에서 오늘을 술 없는 날로 표시해 보세요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "第一日就是連續紀錄的開始，可以在「日誌」把今日標為無酒日。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันแรกคือจุดเริ่มของวันต่อเนื่อง ทำวันนี้เป็นวันไม่ดื่มได้จากไดอารี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlki bir seri başlatır; bugünü Günlük'ten alkolsüz işaretleyin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwszy zaczyna serię — zaznacz dziś w Dzienniku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den første starter en stime — marker i dag som alkoholfri fra dagbogen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang pertama memulai rentetan, tandai hari ini tanpa alkohol dari Catatan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang pertama memulakan rentetan, tanda hari ini bebas alkohol dari Diari."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang una ang magsisimula ng streak, markahang walang alak ang araw na ito mula sa Diary."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày đầu tiên mở ra một chuỗi, đánh dấu hôm nay không cồn từ Nhật ký."
          }
        }
      }
    },
