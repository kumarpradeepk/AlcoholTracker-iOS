          "stringUnit": {
            "state": "translated",
            "value": "I costi compaiono quando registri un bicchiere con il prezzo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격을 적은 잔이 쌓이면 비용이 나타나요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
