          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit ekranındaki hatırlatmalar alkolden hiç söz etmez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia na ekranie blokady nigdy nie wspominają o alkoholu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskeder på låseskærmen nævner aldrig alkohol."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat di layar kunci tidak pernah menyebut alkohol."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan pada skrin kunci tidak sekali-kali menyebut alkohol."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
