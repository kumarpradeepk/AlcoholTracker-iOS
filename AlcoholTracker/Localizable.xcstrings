        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Inscris quelques verres et tes préférés se montreront d'eux-mêmes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota algunos tragos y verás cuáles se repiten más."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra unas cuantas copas y tus habituales se harán ver."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre algumas bebidas e as suas preferidas vão aparecer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra qualche bevanda e le tue preferite verranno fuori da sole."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 잔 기록하면 자주 마시는 술이 드러나요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "記下幾杯，經常飲的自然會浮現。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดสักสองสามแก้ว แล้วแก้วที่ดื่มบ่อยจะเผยตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç içki kaydedin; sık tercihleriniz kendini gösterecek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz kilka drinków, a ulubione same się pokażą."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notér et par drinks, så viser favoritterne sig selv."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat beberapa minuman dan favoritmu akan menampakkan diri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat beberapa minuman dan kegemaran anda akan menampakkan diri."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-log ng ilang inom at lalabas na ang mga paborito mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi thêm vài ly, những lựa chọn quen thuộc sẽ tự lộ ra."
          }
        }
      }
    },
