        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz tyle, ile pasuje. To zostaje między tobą a aplikacją."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg så mange, der passer. Det bliver mellem dig og appen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sebanyak yang terasa benar. Ini urusan kamu dan aplikasi ini saja."
