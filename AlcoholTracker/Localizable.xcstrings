    "pay_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The store is not answering right now. Logging, export and backup keep working either way."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The store is not answering right now. Logging, export and backup keep working either way."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Store antwortet gerade nicht. Erfassen, Export und Sicherung laufen davon unabhängig weiter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアが応答しません。記録、書き出し、バックアップはこれまでどおり使えます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le store ne répond pas pour le moment. La saisie, l'export et la sauvegarde continuent de fonctionner."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La boutique ne répond pas pour le moment. La saisie, l'exportation et la sauvegarde continuent de fonctionner."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El store no responde en este momento. El registro, la exportación y el respaldo siguen funcionando igual."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El store no responde ahora mismo. El registro, la exportación y la copia siguen funcionando igual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A loja não está respondendo agora. Registro, exportação e backup continuam funcionando do mesmo jeito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo store non risponde in questo momento. Registrazione, esportazione e backup continuano a funzionare lo stesso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 스토어가 응답하지 않습니다. 기록, 내보내기, 백업은 그대로 작동합니다."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "商店而家冇回應。紀錄、匯出同備份照樣運作。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ร้านค้าไม่ตอบสนองในตอนนี้ การบันทึก ส่งออก และสำรองข้อมูลยังทำงานได้ตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mağaza şu anda yanıt vermiyor. Kayıt, dışa aktarma ve yedek yine de çalışmaya devam ediyor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sklep w tej chwili nie odpowiada. Zapisywanie, eksport i kopia zapasowa i tak działają."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Butikken svarer ikke lige nu. Notering, eksport og sikkerhedskopi virker uanset hvad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Toko sedang tidak merespons. Pencatatan, ekspor, dan cadangan tetap berjalan seperti biasa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedai tidak menjawab buat masa ini. Rekod, eksport dan sandaran tetap berfungsi seperti biasa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sumasagot ang store ngayon. Gumagana pa rin ang pag-log, export at backup."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa hàng hiện không phản hồi. Ghi chép, xuất dữ liệu và sao lưu vẫn hoạt động bình thường."
          }
        }
      }
    },
    "profile_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same drink lands differently in every body. Two quick details, and your estimates stop being averages and start being yours."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The same drink lands differently in every body. Two quick details, and your estimates stop being averages and start being yours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Getränk wirkt in jedem Körper anders. Zwei kurze Angaben, und aus Durchschnittswerten werden deine Werte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ一杯でも、体によって効き方は違います。ふたつ入れるだけで、推定値は平均ではなく、あなたの数値になります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même verre ne fait pas le même effet dans deux corps différents. Deux informations rapides, et vos estimations cessent d'être des moyennes pour devenir les vôtres."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même verre n'agit pas pareil dans deux corps différents. Deux détails rapides, et tes estimations cessent d'être des moyennes pour devenir les tiennes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo trago no cae igual en dos cuerpos distintos. Dos datos rápidos y tus estimaciones dejan de ser promedios para ser tuyas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma copa no cae igual en dos cuerpos. Dos datos rápidos y tus estimaciones dejan de ser medias para pasar a ser las tuyas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesma bebida cai diferente em cada corpo. Dois detalhes rápidos e suas estimativas deixam de ser médias e passam a ser suas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso bicchiere arriva in modo diverso in ogni corpo. Due dettagli veloci, e le tue stime smettono di essere medie e diventano tue."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 한 잔도 몸마다 다르게 작용해요. 두 가지만 넣으면 추정치가 평균이 아니라 내 것이 돼요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "同一杯酒，落在每個人身上都不一樣。填兩項，估算值就不再是平均數，而是你的。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้วเดียวกันส่งผลกับแต่ละร่างกายไม่เหมือนกัน ใส่แค่สองอย่าง ค่าประมาณก็จะเลิกเป็นค่าเฉลี่ย แล้วกลายเป็นของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı içki her vücutta farklı sonuç verir. İki kısa bilgi, ve tahminleriniz ortalama olmaktan çıkıp size ait olur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sam drink działa inaczej w każdym organizmie. Dwa szybkie szczegóły i szacunki przestają być średnią, a zaczynają być twoje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den samme drink lander forskelligt i hver krop. To hurtige oplysninger, og estimaterne holder op med at være gennemsnit og begynder at være dine."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuman yang sama bekerja berbeda di setiap tubuh. Dua detail singkat, dan perkiraanmu berhenti jadi rata-rata dan mulai jadi milikmu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuman yang sama memberi kesan berbeza pada setiap badan. Dua butiran ringkas, dan anggaran anda berhenti menjadi purata dan mula menjadi milik anda."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba ang dating ng parehong inumin sa bawat katawan. Dalawang mabilisang detalye, at hindi na average ang mga tantiya mo kundi sa iyo na talaga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng một ly nhưng vào mỗi cơ thể lại khác. Hai chi tiết nhỏ, và ước tính không còn là số trung bình mà thành con số của riêng bạn."
          }
        }
      }
    },
