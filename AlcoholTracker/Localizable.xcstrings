    "ob_goals_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick as many as feel true. This stays between you and the app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick as many as feel true. This stays between you and the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl so viele, wie zutreffen. Das bleibt zwischen dir und der App."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当てはまるものを、いくつでも。ここだけの話です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez tout ce qui vous parle. Cela reste entre vous et l'app."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Coche tout ce qui te ressemble. Ça reste entre toi et l'application."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca todas las que te resuenen. Queda entre tú y la app."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca todas las que te suenen ciertas. Esto queda entre la app y tú."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quantas fizerem sentido. Isso fica entre você e o app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tutto quello che ti somiglia. Resta tra te e l'app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당되는 만큼 골라도 돼요. 이 답은 나와 앱 사이에만 남아요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "覺得對的都可以選。這些只留在你和這個 App 之間。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกได้เท่าที่รู้สึกว่าใช่ คำตอบนี้อยู่ระหว่างคุณกับแอปเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğru gelenlerin hepsini seçin. Bu, sizinle uygulama arasında kalır."
