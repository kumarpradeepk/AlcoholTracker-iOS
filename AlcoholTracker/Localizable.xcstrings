    "pay_sub_recurring": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews at %1$@ until you cancel. One tap in Settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews at %1$@ until you cancel. One tap in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich zu %1$@, bis du kündigst. Ein Tipp in den Einstellungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約するまで %1$@ で自動更新されます。設定からワンタップで解約できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle à %1$@ jusqu'à annulation. Un geste dans les Réglages."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle à %1$@ jusqu'à l'annulation. Un geste dans les Réglages."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva por %1$@ hasta que canceles. Un toque en Ajustes."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva por %1$@ hasta que canceles. Un toque en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova por %1$@ até você cancelar. Um toque nos Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova a %1$@ finché non disdici. Un tocco in Impostazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해지할 때까지 %1$@로 갱신됩니다. 설정에서 한 번 탭하면 끝입니다."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "取消之前會以 %1$@ 續期。喺設定㩒一下就得。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่ออายุที่ %1$@ จนกว่าคุณจะยกเลิก แตะเดียวในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edene kadar %1$@ üzerinden yenilenir. Ayarlar'da tek dokunuş."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odnawia się za %1$@, dopóki nie anulujesz. Jedno dotknięcie w Ustawieniach."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes til %1$@, indtil du afmelder. Ét tryk i Indstillinger."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperpanjang seharga %1$@ sampai kamu batalkan. Sekali ketuk di Pengaturan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperbaharui pada %1$@ sehingga anda batalkan. Satu ketikan dalam Tetapan."
          }
        },
        "fil": {
