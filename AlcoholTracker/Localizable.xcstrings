    "dialog_clear_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every log, dry day and setting, gone for good. Export a copy first if you want one."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Every log, drink-free day and setting, gone for good. Export a copy first if you want one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Eintrag, jeder alkoholfreie Tag und jede Einstellung, endgültig weg. Exportiere vorher eine Kopie, wenn du eine möchtest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録も、休肝日も、設定も、すべて完全になくなります。控えが必要なら、先に書き出してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque enregistrement, chaque jour sans alcool et chaque réglage, perdus pour de bon. Exportez une copie d'abord si vous en voulez une."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque inscription, chaque jour sans alcool et chaque réglage, disparus pour de bon. Exporte une copie d'abord si tu en veux une."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada registro, cada día sin alcohol y cada ajuste, perdidos para siempre. Exporta una copia antes si quieres conservarla."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los registros, los días sin alcohol y los ajustes desaparecen para siempre. Si quieres conservarlos, exporta una copia antes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo registro, dia sem álcool e ajuste, perdidos para sempre. Exporte uma cópia antes, se quiser uma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni registrazione, ogni giorno senza alcol e ogni impostazione, spariti per sempre. Se ne vuoi una copia, esportala prima."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록, 술 없는 날, 설정까지 전부 사라져요. 사본이 필요하면 먼저 내보내세요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每一筆記錄、每一個無酒日、每一項設定，都會永遠消失。想留一份的話，先匯出。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกบันทึก ทุกวันไม่ดื่ม และทุกการตั้งค่า จะหายไปถาวร ถ้าอยากเก็บสำเนา ส่งออกไว้ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kayıt, her alkolsüz gün ve her ayar temelli gider. İstiyorsanız önce bir kopyasını dışa aktarın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wpis, każdy dzień bez alkoholu i każde ustawienie — bezpowrotnie. Jeśli chcesz kopię, wyeksportuj ją najpierw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver notering, alkoholfri dag og indstilling — væk for altid. Eksporter en kopi først, hvis du vil have en."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua catatan, hari tanpa alkohol dan pengaturan, hilang selamanya. Ekspor salinannya dulu kalau mau."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap catatan, hari bebas alkohol dan tetapan, hilang selamanya. Eksport satu salinan dahulu jika anda mahukannya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahat ng log, araw na walang alak at setting, tuluyang mawawala. Mag-export muna ng kopya kung gusto mo ng isa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi lần ghi, ngày không cồn và cài đặt sẽ mất hẳn. Hãy xuất một bản sao trước nếu muốn giữ."
          }
        }
      }
    },
