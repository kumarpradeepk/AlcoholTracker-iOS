    "ob_base_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick sense of your rhythm, no judgment, just a starting point."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick sense of your rhythm, no judgement, just a starting point."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Gefühl für deinen Rhythmus, keine Bewertung, einfach ein Startpunkt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リズムをつかむだけです。評価はしません、ただの出発点です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aperçu rapide de votre rythme, sans jugement, juste un point de départ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste un aperçu de ton rythme, sans jugement, un point de départ."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vistazo rápido a tu ritmo, sin juicios, solo un punto de partida."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Una idea rápida de tu ritmo, sin juicios, solo un punto de partida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para ter uma noção do seu ritmo. Sem julgamento, é só um ponto de partida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'idea rapida del tuo ritmo, senza giudizio, solo un punto di partenza."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리듬을 가늠해 보는 것뿐이에요. 평가가 아니라 출발점이에요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只是大概摸一摸你的節奏，不是評價，只是一個起點。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แค่จับจังหวะคร่าวๆ ไม่ได้ตัดสิน เป็นแค่จุดเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritminize hızlı bir bakış — yargı değil, yalnızca bir başlangıç noktası."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybkie wyczucie rytmu — bez oceniania, po prostu punkt wyjścia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en fornemmelse af din rytme — ingen dom, kun et udgangspunkt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekadar gambaran ritmemu, tanpa penilaian, hanya titik awal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambaran ringkas tentang rentak anda, tiada penilaian, hanya titik permulaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabilisang tingin sa ritmo mo, walang paghusga, panimula lang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ để nắm nhịp độ của bạn, không phán xét, chỉ là điểm khởi đầu."
          }
        }
      }
    },
