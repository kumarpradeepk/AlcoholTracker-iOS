    "diary_empty_body_other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If memory serves, add it, backdating keeps your patterns honest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If memory serves, add it, backdating keeps your patterns honest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du dich erinnerst, trag es nach, nachträgliche Einträge halten dein Bild ehrlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚えているなら、あとから足してください。さかのぼって記録すると、傾向が正直なままです。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le souvenir est bon, ajoutez-le : antidater garde vos tendances honnêtes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la mémoire est bonne, ajoute-le : rétrodater garde ton portrait honnête."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te acuerdas, agrégalo: registrar hacia atrás mantiene tus patrones honestos."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo recuerdas, añádelo: registrar con fecha anterior mantiene tus patrones honestos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a memória ajudar, adicione. Registrar com data anterior mantém seus padrões honestos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te lo ricordi, aggiungilo: registrare a posteriori tiene onesto il quadro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억나면 지금 추가해도 돼요. 지난 날짜로 기록해야 패턴이 정직해져요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "記得的話就補上，補回舊日子，模式才誠實。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าพอจำได้ก็เพิ่มเข้าไป ย้อนวันได้ แล้วรูปแบบการดื่มจะตรงตามจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlıyorsanız ekleyin; geriye dönük kayıt, tablonuzu dürüst tutar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli pamięć dopisuje, dodaj wpis — wsteczne wpisy trzymają wzorzec w uczciwości."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Husker du det, så tilføj det. Tilbagedatering holder mønstrene ærlige."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau masih ingat, tambahkan saja, mengisi mundur menjaga polamu tetap jujur."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau masih ingat, tambah sekarang, tarikh ke belakang menjadikan corak anda jujur."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung natatandaan mo pa, idagdag mo, ang pag-backdate ang nagpapanatiling tapat sa mga pattern mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu còn nhớ thì thêm vào, ghi lùi ngày giúp các mẫu hình trung thực."
          }
        }
      }
    },
    "diary_empty_body_today": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you pour, log it in a couple of taps, or mark today dry and let a streak begin."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you pour, log it in a couple of taps, or mark today drink-free and let a streak begin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du dir eingießt, erfass es mit zwei Tipps, oder trag heute als alkoholfrei ein und lass eine Serie beginnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注いだら、二回のタップで記録できます。今日を休肝日にして、続きを始めることもできます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous vous servez, notez-le en deux touches, ou marquez la journée sans alcool et lancez une série."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu te verses quelque chose, inscris-le en deux touches. Ou marque la journée sans alcool et laisse une série commencer."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te sirvas algo, anótalo en dos toques, o marca hoy como día sin alcohol y arranca una racha."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te sirvas algo, regístralo en un par de toques, o marca hoy como día sin alcohol y que empiece la racha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando servir, registre em dois toques — ou marque hoje como dia sem álcool e comece uma sequência."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando versi, bastano due tocchi per registrarlo. Oppure segna oggi come giorno senza alcol e lascia partire una serie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 잔 따르면 두어 번 탭으로 기록하고, 오늘을 술 없는 날로 표시해 연속 기록을 시작해도 좋아요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "斟了就輕點兩下記下來，又或者把今日標為無酒日，讓連續紀錄由此開始。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พอรินแล้วก็แตะสองสามครั้งเพื่อจด หรือทำวันนี้เป็นวันไม่ดื่ม แล้วเริ่มนับวันต่อเนื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doldurduğunuzda birkaç dokunuşla kaydedin ya da bugünü alkolsüz işaretleyip seriyi başlatın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy coś się naleje, wystarczy kilka dotknięć. Albo zaznacz dziś dzień bez alkoholu i zacznij serię."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skænker du op, så notér det med et par tryk — eller marker i dag som alkoholfri og lad en stime begynde."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau menuang, catat dengan beberapa ketukan, atau tandai hari ini tanpa alkohol dan biarkan rentetannya dimulai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda menuang, catat dengan dua tiga ketikan, atau tanda hari ini sebagai hari bebas alkohol dan biarkan rentetan bermula."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag nagsalin ka, i-log ito sa ilang tap, o markahang walang alak ang araw na ito at magsimula ng streak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi rót, hãy ghi lại bằng vài lần chạm, hoặc đánh dấu hôm nay không cồn để bắt đầu một chuỗi ngày."
          }
        }
      }
    },
