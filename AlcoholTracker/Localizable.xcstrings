    "sheet_live_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While your BAC settles, a quiet card stays in the shade, no need to open the app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "While your BAC settles, a quiet card stays in the shade, no need to open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während dein BAK-Wert sinkt, bleibt eine ruhige Karte im Hintergrund, du musst die App nicht öffnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BACが下がっていくあいだ、静かなカードが後ろで待機します。アプリを開く必要はありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant que votre alcoolémie redescend, une carte discrète reste en arrière-plan, sans avoir à ouvrir l'app."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant que ton alcoolémie redescend, une carte discrète reste en retrait, sans avoir à ouvrir l'application."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras tu alcoholemia baja, una tarjeta discreta se queda en segundo plano, sin que tengas que abrir la app."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras tu alcoholemia baja, una tarjeta discreta se queda a la vista sin que tengas que abrir la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto sua estimativa de álcool no sangue baixa, um cartão discreto fica na sombra, sem precisar abrir o app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre il tasso alcolemico scende, una scheda discreta resta sullo sfondo, senza bisogno di aprire l'app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추정 혈중알코올농도가 내려가는 동안, 조용한 카드가 알림 영역에 머물러요. 앱을 열 필요 없어요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "估算的血液酒精濃度回落期間，一張安靜的卡片會留在通知欄，不用打開 App。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างที่ค่าประมาณระดับแอลกอฮอล์ในเลือดค่อยๆ ลดลง การ์ดเงียบๆ ใบหนึ่งจะอยู่ในแถบแจ้งเตือน ไม่ต้องเปิดแอปเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmin düşerken sessiz bir kart gölgede durur; uygulamayı açmaya gerek yok."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopóki alkohol we krwi spada, cicha karta zostaje w tle — bez otwierania aplikacji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens estimatet falder, ligger et roligt kort i skyggen — du behøver ikke åbne appen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama perkiraan BAC turun, sebuah kartu tenang tetap di latar, tanpa perlu membuka aplikasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sementara BAC anda menurun, satu kad senyap kekal di latar, tanpa perlu membuka aplikasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang bumababa ang BAC mo, may tahimik na card na nananatili sa gilid, hindi mo na kailangang buksan ang app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong lúc BAC giảm dần, một thẻ lặng lẽ nằm sẵn ở khu thông báo, không cần mở ứng dụng."
          }
        }
      }
    },
