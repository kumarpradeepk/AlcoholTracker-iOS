    "bac_all_clear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All clear, nothing in your system."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate at zero, nothing in your system."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schätzwert steht bei null, nichts mehr im Körper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定値はゼロです。体内に残っているものはありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation à zéro, plus rien dans l'organisme d'après le calcul."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation à zéro : le calcul n'indique plus d'alcool."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación en cero: según el cálculo, ya no queda nada en tu organismo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación en cero: el cálculo no encuentra nada en tu organismo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimativa zerada: nada mais no seu organismo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stima a zero: secondo il calcolo non è rimasto nulla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추정치가 0이에요. 계산상 남은 양이 없다는 뜻이에요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "估算值已歸零，計算上沒有餘下酒精。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าประมาณเป็นศูนย์แล้ว ตามการคำนวณไม่มีแอลกอฮอล์เหลืออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmin sıfırda — hesapta kalan yok."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunek wskazuje zero, nic już nie jest liczone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimatet står på nul — der er intet tilbage i beregningen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan sudah nol, tidak ada alkohol yang tersisa dalam hitungan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggaran sudah sifar, tiada alkohol tinggal dalam kiraan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero na ang tantiya, wala nang natitira sa kuwenta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước tính đã về 0, không còn cồn trong phép tính."
          }
        }
      }
    },
    "bac_disclaimer_short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates are informational only, never a green light to drive."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates are informational only, never a green light to drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzwerte dienen nur der Information, niemals als grünes Licht zum Fahren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定値はあくまで参考です。運転してよいというゴーサインでは決してありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces estimations sont purement informatives, jamais un feu vert pour conduire."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimations informatives seulement : elles n'autorisent jamais à prendre le volant."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones son solo informativas, nunca una luz verde para manejar."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones son solo informativas; nunca una autorización para ponerse al volante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As estimativas são apenas informativas e nunca liberam você para dirigir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stime sono solo informative: non sono mai un via libera per mettersi alla guida."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추정치는 참고용일 뿐이에요. 운전해도 된다는 뜻은 절대 아니에요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "估算值只供參考，絕不代表可以駕駛。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าประมาณมีไว้ดูเท่านั้น ไม่ใช่สัญญาณว่าขับรถได้โดยเด็ดขาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahminler yalnızca bilgi içindir, asla araç kullanma izni değildir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunki mają charakter wyłącznie informacyjny — nigdy nie są zielonym światłem do jazdy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimater er kun til information — aldrig grønt lys til at køre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan ini hanya informasi, bukan lampu hijau untuk menyetir."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggaran ini maklumat sahaja, bukan lampu hijau untuk memandu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantiya lang ito, hindi ito go signal para mag-drive."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ là ước tính tham khảo, không bao giờ là tín hiệu cho phép lái xe."
          }
        }
      }
    },
    "bac_free_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Pro, log a drink, and your estimated BAC settles in here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Pro, log a drink, and your estimated BAC settles in here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Pro frei, erfasse ein Getränk, und dein geschätzter BAK-Wert erscheint hier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proにすると、一杯記録するだけで、推定BACがここに表示されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez à Pro, enregistrez un verre, et votre alcoolémie estimée s'installe ici."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe à Pro, inscris un verre, et ton alcoolémie estimée vient se poser ici."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Pro, anota un trago y tu alcoholemia estimada aparece aquí."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea Pro, registra una copa y tu alcoholemia estimada aparecerá aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Pro, registre uma bebida e sua estimativa de álcool no sangue aparece aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca Pro, registra un bicchiere e qui compare il tuo tasso alcolemico stimato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro를 열고 한 잔을 기록하면 추정 혈중알코올농도가 여기에 나타나요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖 Pro，記下一杯，估算的血液酒精濃度就會在這裏顯示。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลดล็อก Pro จดสักแก้ว แล้วค่าประมาณระดับแอลกอฮอล์ในเลือดจะมาแสดงตรงนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro'yu açın, bir içki kaydedin; tahmini kandaki alkol değeriniz burada belirir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj Pro, zapisz drinka, a szacowany alkohol we krwi pojawi się tutaj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås Pro op, notér en drink — så falder dit estimat på plads her."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pro, catat satu minuman, dan perkiraan BAC akan turun pelan di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pro, catat satu minuman, dan anggaran BAC anda akan muncul di sini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-unlock ang Pro, mag-log ng inom, at dito lalabas ang tinatayang BAC mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa Pro, ghi một ly, ước tính BAC sẽ hiện ra ở đây."
          }
        }
      }
    },
