    "sheet_bac_never_drive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never use an estimate to decide whether it's safe to drive. When in doubt, don't."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Never use an estimate to decide whether it's safe to drive. When in doubt, don't."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheide niemals anhand einer Schätzung, ob du fahrtüchtig bist. Im Zweifel: nicht fahren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運転できるかどうかの判断に、推定値を使っては絶対にいけません。少しでも迷ったら、運転しないでください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vous servez jamais d'une estimation pour décider de prendre le volant. Dans le doute, ne conduisez pas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne te sers jamais d'une estimation pour décider de prendre le volant. Dans le doute, ne conduis pas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca uses una estimación para decidir si te pones al volante. Ante la duda, no manejes."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No uses nunca una estimación para decidir si ponerte al volante. Ante la duda, no conduzcas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca use uma estimativa para decidir se pode dirigir. Na dúvida, não dirija."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non usare mai una stima per decidere se metterti alla guida. Nel dubbio, non guidare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운전해도 되는지를 추정치로 판단하면 절대 안 돼요. 조금이라도 망설여진다면, 하지 마세요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "絕對不要用估算值去判斷可不可以駕駛。只要有半點猶豫，就不要駕駛。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้ามใช้ค่าประมาณตัดสินว่าขับรถได้หรือไม่ โดยเด็ดขาด ถ้าลังเลแม้เพียงนิดเดียว อย่าขับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç kullanıp kullanamayacağınıza karar vermek için asla bir tahmine dayanmayın. Şüphe varsa: kullanmayın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunek nigdy nie jest podstawą do decyzji o prowadzeniu pojazdu. W razie wątpliwości: nie prowadź."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug aldrig et estimat til at afgøre, om det er forsvarligt at køre. Er du i tvivl: lad være med at køre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan pernah memakai perkiraan untuk memutuskan apakah aman menyetir. Kalau ragu sedikit saja, jangan menyetir."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan sekali-kali gunakan anggaran untuk memutuskan sama ada selamat memandu. Jika ragu-ragu sedikit pun, jangan memandu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huwag na huwag gamitin ang tantiya para magpasya kung ligtas nang mag-drive. Kapag may duda, huwag mag-drive."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuyệt đối không dùng số liệu ước tính để quyết định có lái xe hay không. Đã uống rượu bia thì không lái xe."
          }
        }
      }
    },
    "sheet_bac_not_measurement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's an estimate, not a measurement. Food, medication, and your own biology all shift the real number."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's an estimate, not a measurement. Food, medication and your own biology all shift the real number."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine Schätzung, keine Messung. Essen, Medikamente und deine eigene Biologie verschieben den tatsächlichen Wert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは推定であって、測定ではありません。食事も、薬も、あなた自身の体質も、実際の数値を動かします。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est une estimation, pas une mesure. L'alimentation, les médicaments et votre propre biologie déplacent tous le chiffre réel."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est une estimation, pas une mesure. La nourriture, les médicaments et ta propre biologie déplacent tous le vrai chiffre."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una estimación, no una medición. La comida, los medicamentos y tu propia biología mueven el número real."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una estimación, no una medición. La comida, los medicamentos y tu propia biología desplazan el número real."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É uma estimativa, não uma medição. Comida, medicamentos e a sua própria biologia mudam o número real."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una stima, non una misurazione. Cibo, farmaci e la tua biologia spostano tutti il numero reale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추정치일 뿐, 측정값이 아니에요. 음식, 약, 그리고 각자의 몸이 실제 수치를 다르게 만들어요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這是估算，不是量度。食物、藥物，以及你自己的身體，都會令真實數字不同。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือค่าประมาณ ไม่ใช่ค่าที่วัดได้ อาหาร ยา และร่างกายของแต่ละคน ล้วนทำให้ตัวเลขจริงเปลี่ยนไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir tahmindir, ölçüm değildir. Yemek, ilaçlar ve kendi biyolojiniz gerçek sayıyı değiştirir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To szacunek, nie pomiar. Jedzenie, leki i własna biologia przesuwają rzeczywistą wartość."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er et estimat, ikke en måling. Mad, medicin og din egen biologi flytter alle det virkelige tal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini perkiraan, bukan pengukuran. Makanan, obat, dan kondisi tubuhmu sendiri semuanya menggeser angka yang sebenarnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini anggaran kandungan alkohol dalam darah, bukan pengukuran. Makanan, ubat dan biologi anda sendiri semuanya menggeser angka sebenar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantiya ito, hindi sukat. Ang pagkain, gamot, at ang sarili mong biyolohiya ay nagbabago sa totoong numero."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là ước tính, không phải phép đo. Thức ăn, thuốc men và cơ địa mỗi người đều làm lệch con số thật."
          }
        }
      }
    },
    "sheet_bac_widmark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use the Widmark method: the alcohol you've logged, spread over your body water (from weight and sex), minus what your body clears, about 0.015% every hour."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We use the Widmark method: the alcohol you've logged, spread over your body water (from weight and sex), minus what your body clears, about 0.015% every hour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir rechnen nach Widmark: der Alkohol, den du erfasst hast, verteilt auf dein Körperwasser (aus Gewicht und Geschlecht), abzüglich dessen, was dein Körper abbaut, etwa 0,015 % pro Stunde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィドマーク法で計算しています。記録したアルコールを体水分量(体重と性別から求めます)に広げ、体が分解する分、1時間あたり約0.015%を差し引きます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous utilisons la méthode de Widmark : l'alcool que vous avez enregistré, réparti dans l'eau de votre corps (déduite du poids et du sexe), moins ce que votre organisme élimine, environ 0,015 % par heure."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "On utilise la méthode de Widmark : l'alcool que tu as inscrit, réparti dans ton eau corporelle (calculée à partir du poids et du sexe), moins ce que ton organisme élimine, environ 0,015 % à l'heure."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usamos el método de Widmark: el alcohol que registraste, repartido en el agua de tu cuerpo (según el peso y el sexo), menos lo que tu organismo elimina, cerca de 0.015 % por hora."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Usamos el método Widmark: el alcohol que has registrado, repartido en el agua corporal (a partir del peso y el sexo), menos lo que tu cuerpo elimina, en torno a un 0,015 % cada hora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usamos o método Widmark: o álcool que você registrou, distribuído pela água do seu corpo (calculada a partir do peso e do sexo), menos o que o organismo elimina, cerca de 0,015% por hora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usiamo il metodo di Widmark: l'alcol che hai registrato, distribuito nell'acqua corporea (calcolata da peso e sesso), meno quello che il corpo elimina, circa lo 0,015% ogni ora."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위드마크(Widmark) 공식을 써요. 기록한 알코올을 체중과 성별에서 계산한 체내 수분량에 나누고, 몸이 시간당 약 0.015%씩 분해하는 만큼을 빼요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我們用 Widmark 公式：把你記下的酒精，分散到由體重和性別推算的身體水分之中，再減去身體代謝掉的部分，大約每小時 0.015%。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราใช้สูตร Widmark คือเอาแอลกอฮอล์ที่คุณจดไว้ กระจายลงในน้ำในร่างกาย ซึ่งคำนวณจากน้ำหนักและเพศ แล้วหักส่วนที่ร่างกายกำจัดออก ราว 0.015% ต่อชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widmark yöntemini kullanıyoruz: kaydettiğiniz alkol, vücut suyunuza (ağırlık ve cinsiyetten hesaplanır) dağılır; vücudunuzun temizlediği miktar düşülür — saatte yaklaşık %0,015."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stosujemy metodę Widmarka: zapisany alkohol rozłożony na wodę w organizmie (z masy ciała i płci), minus to, co organizm usuwa — około 0,015 % na godzinę."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi bruger Widmarks metode: den alkohol, du har noteret, fordelt i din kropsvæske (ud fra vægt og køn), minus det, kroppen når at forbrænde — omkring 0,015 % i timen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami memakai metode Widmark: alkohol yang sudah kamu catat, disebar ke air tubuh (dihitung dari berat badan dan jenis kelamin), dikurangi yang sudah diuraikan tubuh, sekitar 0,015% setiap jam."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami menggunakan kaedah Widmark: alkohol yang anda catat, disebarkan ke seluruh air badan anda (daripada berat dan jantina), tolak apa yang dihapuskan oleh badan anda, kira-kira 0.015% setiap jam."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit namin ang Widmark method: ang alkohol na na-log mo, ikinakalat sa tubig ng katawan mo (mula sa timbang at kasarian), bawas ang naaalis ng katawan mo, mga 0.015% kada oras."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng dùng phương pháp Widmark: lượng cồn đã ghi, dàn đều trong lượng nước cơ thể (tính từ cân nặng và giới tính sinh học), trừ đi phần cơ thể đào thải, khoảng 0,015% mỗi giờ."
          }
        }
      }
    },
    "sheet_cal_hint_dry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a past day to mark it dry, tap again to unmark. Days with drinks stay as they are."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a past day to mark it drink-free, tap again to unmark. Days with drinks stay as they are."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe einen vergangenen Tag an, um ihn als alkoholfrei zu markieren, tippe erneut, um das zurückzunehmen. Tage mit Einträgen bleiben, wie sie sind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の日をタップすると休肝日になります。もう一度タップすると取り消せます。記録のある日はそのままです。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un jour passé pour le marquer sans alcool, touchez-le à nouveau pour annuler. Les jours avec consommations restent tels quels."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur un jour passé pour le marquer sans alcool, appuie de nouveau pour l'annuler. Les jours avec verres restent tels quels."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un día pasado para marcarlo sin alcohol; tócalo otra vez para deshacerlo. Los días con tragos quedan igual."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa un día pasado para marcarlo sin alcohol y púlsalo otra vez para quitar la marca. Los días con copas se quedan como están."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um dia passado para marcá-lo como dia sem álcool; toque de novo para desmarcar. Dias com bebidas ficam como estão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un giorno passato per segnarlo senza alcol, tocca di nuovo per annullare. I giorni con bevande restano come sono."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 날짜를 탭하면 술 없는 날로 표시되고, 다시 탭하면 해제돼요. 기록이 있는 날은 그대로 둬요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點過往的日子就標為無酒日，再點一次取消。有記錄的日子維持不變。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะวันที่ผ่านมาเพื่อทำเป็นวันไม่ดื่ม แตะอีกครั้งเพื่อเอาออก วันที่มีบันทึกจะคงไว้ตามเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş bir güne dokunup alkolsüz işaretleyin, tekrar dokunup kaldırın. İçki kaydı olan günler olduğu gibi kalır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij minionego dnia, aby oznaczyć go jako dzień bez alkoholu; dotknij ponownie, aby cofnąć. Dni z wpisami zostają bez zmian."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en tidligere dag for at markere den alkoholfri, tryk igen for at fjerne markeringen. Dage med drinks bliver, som de er."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk hari yang sudah lewat untuk menandainya tanpa alkohol, ketuk lagi untuk membatalkan. Hari yang ada catatan minumnya tidak berubah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik hari yang lepas untuk menandakannya bebas alkohol, ketik sekali lagi untuk membuang tanda. Hari yang ada minuman kekal seperti sedia ada."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang nakaraang araw para markahang walang alak, i-tap ulit para alisin. Hindi magbabago ang mga araw na may inom."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một ngày đã qua để đánh dấu không cồn, chạm lần nữa để bỏ. Những ngày có đồ uống vẫn giữ nguyên."
          }
        }
      }
    },
    "sheet_cal_hint_select": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tide dots are logged days; moss dots are dry days. Tap one to open it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue dots are logged days; green dots are drink-free days. Tap one to open it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blaue Punkte sind Tage mit Einträgen, grüne Punkte alkoholfreie Tage. Tippe einen an, um ihn zu öffnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "青い点は記録のある日、緑の点は休肝日です。タップすると開きます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points bleus signalent les jours enregistrés, les verts les jours sans alcool. Touchez-en un pour l'ouvrir."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points bleus marquent les jours avec verres, les verts les jours sans alcool. Appuie sur un jour pour l'ouvrir."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos azules son días con registro; los verdes, días sin alcohol. Toca uno para abrirlo."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos azules son días con registro; los verdes, días sin alcohol. Pulsa uno para abrirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontos azuis são dias com registro; pontos verdes são dias sem álcool. Toque em um para abrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pallini blu sono i giorni registrati, quelli verdi i giorni senza alcol. Tocca un giorno per aprirlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파란 점은 기록이 있는 날, 초록 점은 술 없는 날이에요. 탭하면 열려요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "藍點是有記錄的日子，綠點是無酒日。輕點一下就可以打開。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จุดสีฟ้าคือวันที่มีบันทึก จุดสีเขียวคือวันไม่ดื่ม แตะเพื่อเปิดดู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mavi noktalar kayıt yapılan günler, yeşil noktalar alkolsüz günler. Açmak için birine dokunun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niebieskie kropki to dni z wpisami, zielone — dni bez alkoholu. Dotknij, aby otworzyć."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blå prikker er dage med noteringer, grønne prikker er alkoholfrie dage. Tryk på en for at åbne den."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Titik biru menandai hari dengan catatan; titik hijau menandai hari tanpa alkohol. Ketuk salah satu untuk membukanya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bintik biru ialah hari yang dicatat; bintik hijau ialah hari bebas alkohol. Ketik satu untuk membukanya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang asul na tuldok ay mga araw na may na-log; ang berdeng tuldok ay mga araw na walang alak. I-tap ang isa para buksan ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chấm xanh dương là ngày có ghi, chấm xanh lá là ngày không cồn. Chạm vào một ngày để mở."
          }
        }
      }
    },
