    "units_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These only change how numbers read, never what you logged."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "These only change how numbers read, never what you logged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ändert nur, wie Zahlen dargestellt werden, nie das, was du erfasst hast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変わるのは数字の見え方だけで、記録した内容は変わりません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela change seulement l'affichage des chiffres, jamais ce que vous avez enregistré."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça change seulement la façon dont les chiffres s'affichent, jamais ce que tu as inscrit."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo cambia cómo se leen los números, nunca lo que registraste."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo cambia cómo se leen los números, nunca lo que registraste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso só muda como os números aparecem, nunca o que você registrou."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiano solo come si leggono i numeri, mai quello che hai registrato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시 방식만 바뀌고, 기록한 내용은 그대로예요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這些只會改變數字的顯示方式，不會改動你記下的內容。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งเหล่านี้เปลี่ยนแค่วิธีอ่านตัวเลข ไม่ได้เปลี่ยนสิ่งที่คุณจดไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar yalnızca sayıların nasıl göründüğünü değiştirir, kaydettiklerinizi değil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zmienia tylko sposób wyświetlania liczb, nigdy tego, co zapisano."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ændrer kun, hvordan tallene læses — aldrig det, du har noteret."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya mengubah cara angka dibaca, bukan apa yang sudah dicatat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya mengubah cara nombor dibaca, bukan apa yang anda catat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binabago lang nito kung paano basahin ang mga numero, hindi ang na-log mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những lựa chọn này chỉ đổi cách hiển thị con số, không đổi những gì đã ghi."
          }
        }
      }
