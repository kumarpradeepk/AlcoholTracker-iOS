    "log_tune_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the pour to match what was actually on the table."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the pour to match what was actually on the table."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass die Menge an das an, was wirklich im Glas war."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際にテーブルにあったものに合わせて、量を調整してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez le service pour coller à ce qu'il y avait vraiment sur la table."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la portion pour qu'elle corresponde à ce qu'il y avait vraiment sur la table."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el servido para que coincida con lo que había de verdad en la mesa."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la medida para que coincida con lo que había de verdad en la mesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a dose para o que estava de fato na mesa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la quantità per farla combaciare con quello che c'era davvero sul tavolo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제로 테이블에 있던 잔에 맞게 조정해 보세요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "調到跟枱面上那一杯一樣。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับให้ตรงกับแก้วที่อยู่บนโต๊ะจริงๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masadaki gerçek ölçüye uyacak şekilde ayarlayın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasuj porcję do tego, co naprawdę stało na stole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster mængden, så den passer med det, der faktisk stod på bordet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan takarannya dengan yang benar-benar ada di meja."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laraskan tuangan supaya sepadan dengan apa yang sebenarnya ada di atas meja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iayon ang laki ng inom sa kung ano talaga ang nasa mesa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉnh lại phần rót cho khớp với thứ thực sự có trên bàn."
          }
        }
      }
    },
