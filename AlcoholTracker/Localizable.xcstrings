          "stringUnit": {
            "state": "translated",
            "value": "Le importazioni si uniscono a quello che c'è già, i duplicati vengono saltati in silenzio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오면 지금 있는 것과 합쳐지고, 중복은 조용히 건너뛰어요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入會與現有內容合併，重複的會靜靜略過。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำเข้าจะรวมกับที่มีอยู่ รายการซ้ำจะถูกข้ามไปเงียบๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılanlar buradakilerle birleşir; tekrarlananlar sessizce atlanır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import łączy się z tym, co już jest — duplikaty są po cichu pomijane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Import flettes med det, der allerede er her — dubletter springes stille over."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor digabung dengan yang sudah ada, duplikat dilewati diam-diam."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Import bergabung dengan apa yang ada, pendua dilangkau secara senyap."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinasama ang mga na-import sa nandito na, tahimik na nilalaktawan ang mga duplicate."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu nhập vào sẽ hòa với dữ liệu sẵn có, các mục trùng được lặng lẽ bỏ qua."
          }
        }
      }
    },
