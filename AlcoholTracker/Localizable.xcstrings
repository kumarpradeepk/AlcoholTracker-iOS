    "pay_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your full drinking history, a live BAC estimate, and the weekly trend that shows where a heavy month starts."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your full drinking history, a live BAC estimate, and the weekly trend that shows where a heavy month starts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein vollständiger Trinkverlauf, eine laufende BAK-Schätzung und der Wochentrend, der zeigt, wo ein schwerer Monat beginnt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飲酒履歴のすべて、リアルタイムの血中アルコール濃度の推定、そして重い月がどこから始まるかを示す週ごとの傾向。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre historique complet, une estimation d'alcoolémie en direct et la tendance hebdomadaire qui montre où commence un mois chargé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre historique complet, une estimation d'alcoolémie en direct et la tendance hebdomadaire qui montre où commence un mois chargé."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu historial completo, una estimación de alcoholemia en vivo y la tendencia semanal que muestra dónde empieza un mes cargado."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu historial completo, una estimación de alcoholemia en directo y la tendencia semanal que enseña dónde empieza un mes cargado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu histórico completo, uma estimativa de alcoolemia ao vivo e a tendência semanal que mostra onde começa um mês pesado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo storico completo, una stima dell'alcolemia in tempo reale e l'andamento settimanale che mostra dove comincia un mese pesante."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 음주 기록, 실시간 혈중 알코올 농도 추정치, 그리고 무거운 한 달이 어디서 시작되는지 보여 주는 주간 추세."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你完整嘅飲酒紀錄、即時血液酒精濃度估算，同埋顯示邊度開始變成沉重一個月嘅每週趨勢。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติการดื่มทั้งหมดของคุณ ค่าประมาณแอลกอฮอล์ในเลือดแบบเรียลไทม์ และแนวโน้มรายสัปดาห์ที่บอกว่าเดือนหนัก ๆ เริ่มตรงไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm içki geçmişin, anlık promil tahmini ve ağır bir ayın nerede başladığını gösteren haftalık eğilim."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja pełna historia picia, bieżące oszacowanie promili i tygodniowy trend, który pokazuje, gdzie zaczyna się ciężki miesiąc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele din drikkehistorik, et løbende promilleestimat og den ugentlige tendens, der viser, hvor en tung måned begynder."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh riwayat minummu, perkiraan kadar alkohol langsung, dan tren mingguan yang menunjukkan di mana bulan berat itu dimulai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah minuman anda sepenuhnya, anggaran kandungan alkohol secara langsung, dan aliran mingguan yang menunjukkan di mana bulan berat bermula."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buong history ng iyong pag-inom, live na tantiya ng alcohol level, at ang weekly trend na nagpapakita kung saan nagsisimula ang mabigat na buwan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ lịch sử uống của bạn, ước tính nồng độ cồn theo thời gian thực, và xu hướng hằng tuần cho thấy một tháng nặng bắt đầu từ đâu."
          }
        }
      }
    },
    "pay_sub_lifetime": {
