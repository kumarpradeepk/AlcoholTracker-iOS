          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni senza alcol sono stati il %1$d%% del periodo. Ognuno è riposo che il corpo sente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 기간의 %1$d%%가 술 없는 날이었어요. 하루하루가 몸이 알아채는 휴식이에요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "今期有 %1$d%% 是無酒日。每一日，身體都感覺得到那份休息。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงนี้มีวันไม่ดื่ม %1$d%% ทุกวันคือการพักที่ร่างกายรับรู้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dönemde alkolsüz gün oranı %%%1$d. Her biri, vücudunuzun fark ettiği bir dinlenme."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni bez alkoholu to %1$d %% tego okresu. Każdy z nich to odpoczynek, który organizm zauważa."
