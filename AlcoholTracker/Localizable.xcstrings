    "sheet_units_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g of pure alcohol, the yardstick the WHO uses. Every glass hides a different amount of it, so we do the math for you."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g of pure alcohol, the yardstick the WHO uses. Every glass hides a different amount of it, so we do the maths for you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g reiner Alkohol, der Maßstab der WHO. In jedem Glas steckt eine andere Menge davon, also rechnen wir das für dich aus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "純アルコール10g、WHOが使うものさしです。グラスごとに含まれる量は違うので、計算はこちらでやります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g d'alcool pur, l'étalon retenu par l'OMS. Chaque verre en cache une quantité différente : le calcul, c'est nous qui le faisons."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g d'alcool pur, l'étalon retenu par l'OMS. Chaque verre en cache une quantité différente, alors on fait le calcul à ta place."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g de alcohol puro, la vara que usa la OMS. Cada vaso esconde una cantidad distinta, así que la cuenta la hacemos nosotros."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g de alcohol puro, la vara de medir que usa la OMS. Cada copa esconde una cantidad distinta, así que hacemos las cuentas por ti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g de álcool puro, a régua que a OMS usa. Cada copo esconde uma quantidade diferente, então a gente faz a conta para você."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g di alcol puro, il metro che usa l'OMS. Ogni bicchiere ne nasconde una quantità diversa, quindi il calcolo lo facciamo noi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순수 알코올 10 g, WHO가 쓰는 잣대예요. 잔마다 그 양이 다르게 숨어 있어서, 계산은 앱이 대신해요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "10 克純酒精，世衞用的那把尺。每一杯藏着的份量都不同，所以計算交給我們。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอลกอฮอล์บริสุทธิ์ 10 กรัม คือไม้บรรทัดที่องค์การอนามัยโลกใช้ แต่ละแก้วซ่อนปริมาณไว้ไม่เท่ากัน เราจึงคำนวณให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g saf alkol — DSÖ'nün kullandığı ölçü. Her bardak farklı miktarda barındırır; hesabı biz yapıyoruz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g czystego alkoholu — miara, którą stosuje WHO. Każda szklanka kryje w sobie inną ilość, więc liczymy to za ciebie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g ren alkohol — den målestok, WHO bruger. Hvert glas gemmer på sin egen mængde, så vi regner den ud for dig."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g alkohol murni, tolok ukur yang dipakai WHO. Setiap gelas menyembunyikan jumlah yang berbeda, jadi hitungannya kami yang kerjakan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g alkohol tulen, ukuran yang digunakan WHO. Setiap gelas menyembunyikan jumlah yang berbeza, jadi kami yang kira untuk anda."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g na purong alkohol, ang panukat na ginagamit ng WHO. Iba-iba ang dami nito sa bawat baso, kaya kami na ang bahala sa matematika."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "10 g cồn nguyên chất, thước đo mà WHO sử dụng. Mỗi ly chứa một lượng khác nhau, nên phép tính để ứng dụng lo."
          }
        }
      }
    },
