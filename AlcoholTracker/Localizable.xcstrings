        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj din profil og notér en drink — kurven begynder med den første."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi profilmu dan catat satu minuman, garis trenmu dimulai dari tuangan pertama."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah profil anda dan catat satu minuman, garis trend anda bermula dengan tuangan pertama."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Idagdag ang profile mo at mag-log ng inom, magsisimula ang trend line mo sa unang tala."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm hồ sơ và ghi một ly, đường xu hướng bắt đầu từ lần rót đầu tiên."
          }
        }
      }
    },
