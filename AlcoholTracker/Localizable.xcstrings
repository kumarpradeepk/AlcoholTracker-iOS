    "quicklog_watch_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the Watch app didn't install itself, add it from the iPhone Watch app under Available Apps."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If the Watch app didn't install itself, add it from the iPhone Watch app under Available Apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls sich die Watch-App nicht selbst installiert hat, füge sie in der iPhone-App „Watch\" unter „Verfügbare Apps\" hinzu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch Appが自動でインストールされない場合は、iPhoneの「Watch」Appの「使用可能なApp」から追加してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l'app Watch ne s'est pas installée toute seule, ajoutez-la depuis l'app Watch sur iPhone, dans Apps disponibles."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l'app Watch ne s'est pas installée d'elle-même, ajoute-la depuis l'app Watch de l'iPhone, sous « Apps disponibles »."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la app de Watch no se instaló sola, agrégala desde la app Watch del iPhone, en Apps disponibles."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la app del Watch no se ha instalado sola, añádela desde la app Watch del iPhone, en Apps disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o app do Watch não se instalou sozinho, adicione-o pelo app Watch do iPhone, em Apps Disponíveis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l'app per Watch non si è installata da sola, aggiungila dall'app Watch su iPhone, in App disponibili."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 앱이 저절로 설치되지 않았다면, iPhone의 Watch 앱에서 '사용 가능한 App'을 통해 추가하세요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Watch App 沒有自動安裝，可在 iPhone 的「Watch」App 中，於「可用的 App」加入。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าแอป Watch ไม่ได้ติดตั้งเอง ให้เพิ่มจากแอป Watch บน iPhone ในหัวข้อ \"แอปที่ใช้ได้\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch uygulaması kendiliğinden yüklenmediyse iPhone'daki Watch uygulamasında Kullanılabilir Uygulamalar bölümünden ekleyin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli aplikacja na Watch nie zainstalowała się sama, dodaj ją w aplikacji Watch na iPhonie, w sekcji Dostępne aplikacje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis Watch-appen ikke installerede sig selv, kan du tilføje den fra Watch-appen på din iPhone under Tilgængelige apps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
