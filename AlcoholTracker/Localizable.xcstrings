          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coûts apparaissent dès qu'un prix est enregistré."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coûts apparaissent dès qu'un verre a un prix."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los costos aparecen cuando anotas un trago con precio."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los costes aparecen cuando registras una copa con precio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os custos aparecem quando você registra uma bebida com preço."
          }
        },
