        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월간 목표는 자동으로 따라와요: %1$d %2$@. WHO 기준은 출처일 뿐, 판정이 아니에요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每月目標會自動跟着：%1$d %2$@。世衞的指引是一個出處，不是一個判決。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป้าหมายรายเดือนจะตามมาเองโดยอัตโนมัติ %1$d %2$@ แนวทางขององค์การอนามัยโลกเป็นแหล่งอ้างอิง ไม่ใช่คำตัดสิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık hedefiniz otomatik olarak belirlenir: %1$d %2$@. DSÖ rehberi bir kaynaktır, bir hüküm değil."
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cel miesięczny wylicza się automatycznie: %1$d jednostka. Wytyczne WHO to źródło, nie wyrok."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "…%1$d jednostki…"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "…%1$d jednostek…"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "…%1$d jednostki…"
                }
              }
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit månedlige mål følger automatisk med: %1$d %2$@. WHO's retningslinje er en kilde, ikke en dom."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Target bulananmu mengikuti otomatis: %1$d %2$@. Pedoman WHO adalah rujukan, bukan vonis."
