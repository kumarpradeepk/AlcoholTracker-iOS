    "notif_repeat_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each reminder repeats daily. Tap − to remove one."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Each reminder repeats daily. Tap − to remove one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Erinnerung wiederholt sich täglich. Tippe auf −, um eine zu entfernen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーは毎日くり返します。− をタップすると削除できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque rappel se répète chaque jour. Touchez − pour en retirer un."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque rappel revient tous les jours. Appuie sur − pour en retirer un."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada recordatorio se repite a diario. Toca − para quitar uno."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada recordatorio se repite a diario. Pulsa − para quitar uno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada lembrete se repete todo dia. Toque em − para remover."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni promemoria si ripete ogni giorno. Tocca − per rimuoverlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 매일 반복돼요. − 를 탭하면 지워져요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每個提醒都會每日重複。輕點 − 可以移除。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเตือนแต่ละรายการจะซ้ำทุกวัน แตะ − เพื่อลบออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hatırlatıcı günlük tekrarlanır. Kaldırmak için − işaretine dokunun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde przypomnienie powtarza się codziennie. Dotknij −, aby usunąć."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver påmindelse gentages dagligt. Tryk på − for at fjerne en."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pengingat berulang setiap hari. Ketuk − untuk menghapus satu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap peringatan berulang setiap hari. Ketik − untuk membuang satu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inuulit araw-araw ang bawat paalala. I-tap ang − para alisin ang isa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lời nhắc lặp lại hằng ngày. Chạm − để gỡ một lời nhắc."
          }
        }
      }
    },
