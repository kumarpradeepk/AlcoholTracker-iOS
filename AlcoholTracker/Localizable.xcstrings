    "dialog_delete_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It leaves your diary, and your numbers settle back down."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It leaves your diary, and your numbers settle back down."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es verlässt dein Tagebuch, und deine Zahlen gehen wieder zurück."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日記から消えて、数字も元に戻ります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il quitte votre journal et vos chiffres redescendent."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sort de ton journal, et tes chiffres redescendent."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de tu diario y tus números vuelven a bajar."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de tu diario y tus números vuelven a bajar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela sai do seu diário e seus números voltam ao lugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce dal diario e i tuoi numeri tornano giù."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록에서 빠지고, 숫자도 함께 내려가요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "它會離開你的日誌，數字亦會跟着回落。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันจะออกจากไดอารี่ และตัวเลขของคุณจะลดกลับลงมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlüğünüzden çıkar, sayılarınız da geri iner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zniknie z dziennika, a liczby wrócą na swoje miejsce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den forlader dagbogen, og tallene falder tilbage på plads."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia keluar dari catatanmu, dan angkamu turun kembali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia meninggalkan diari anda, dan nombor anda kembali turun."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalis ito sa diary mo, at babalik sa dati ang mga numero mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục này rời khỏi nhật ký, và các con số lùi lại như cũ."
          }
        }
      }
    },
