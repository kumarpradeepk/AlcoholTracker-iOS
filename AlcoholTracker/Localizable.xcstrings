    "guideline_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WHO low-risk guideline suggests up to 2 units a day, with regular drink-free days. Set what feels right for you."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The WHO low-risk guideline suggests up to 2 units a day, with regular drink-free days. Set what feels right for you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die WHO-Empfehlung für risikoarmen Konsum nennt als Obergrenze 2 %1$@ pro Tag, dazu regelmäßige alkoholfreie Tage. Stell ein, was für dich passt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOの低リスク指針は、1日の上限を2%1$@とし、あわせて定期的な休肝日を挙げています。あなたに合う値を設定してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le repère de moindre risque de l'OMS place le plafond à 2 unités par jour, avec des jours sans alcool réguliers. À vous de fixer ce qui vous convient."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le repère de moindre risque de l'OMS suggère un maximum de 2 %1$@ par jour, avec des jours sans alcool réguliers. Fixe ce qui te convient."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La referencia de bajo riesgo de la OMS pone el techo en 2 unidades al día, con días sin alcohol regulares. Define lo que te funcione a ti."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La recomendación de bajo riesgo de la OMS sugiere un máximo de 2 %1$@ al día, con días sin alcohol con regularidad. Ajusta lo que te encaje a ti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A diretriz de baixo risco da OMS sugere no máximo 2 doses por dia, com dias sem álcool regulares. Defina o que fizer sentido para você."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riferimento OMS a basso rischio indica fino a 2 %1$@ al giorno, con giorni senza alcol regolari. Imposta quello che ti sembra giusto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 저위험 기준은 하루 최대 2 %1$@와 규칙적인 술 없는 날을 제안해요. 나에게 맞는 값으로 정하세요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "世衞的低風險指引建議每日最多 2 %1$@，並且定期有無酒日。設一個你覺得合適的數。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนวทางความเสี่ยงต่ำขององค์การอนามัยโลกเสนอไม่เกิน 2 %1$@ ต่อวัน และให้มีวันไม่ดื่มอย่างสม่ำเสมอ ตั้งค่าที่รู้สึกว่าเหมาะกับคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSÖ'nün düşük riskli tüketim rehberi günde en çok 2 %1$@ ve düzenli alkolsüz günler öneriyor. Size uygun olanı siz belirleyin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wytyczne WHO dotyczące niskiego ryzyka wskazują górną granicę 2 jednostek dziennie i regularne dni bez alkoholu. Ustaw to, co pasuje tobie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO's retningslinje for lav risiko peger på højst 2 %1$@ om dagen, med jævnlige alkoholfrie dage. Sæt det, der passer dig."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedoman risiko rendah WHO menyarankan paling banyak 2 %1$@ per hari, dengan hari tanpa alkohol secara teratur. Setel yang terasa pas untukmu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Garis panduan risiko rendah WHO mencadangkan sehingga 2 %1$@ sehari, dengan hari bebas alkohol yang tetap. Tetapkan apa yang sesuai untuk anda."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iminumungkahi ng mababang-panganib na guideline ng WHO ang hanggang 2 na %1$@ kada araw, kasama ang regular na araw na walang inom. Itakda kung ano ang tama para sa iyo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khuyến nghị nguy cơ thấp của WHO đề xuất tối đa 2 %1$@ mỗi ngày, kèm những ngày không cồn đều đặn. Hãy đặt mức phù hợp với bạn."
          }
        }
      }
    },
