    "sheet_units_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's a unit, really?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What's a unit, really?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist eine Einheit eigentlich?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@って、そもそも何?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : c'est quoi, au juste ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, c'est quoi au juste ?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: ¿qué es exactamente?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es exactamente %1$@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que é uma dose, afinal?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che cos'è davvero %1$@?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 정확히 뭐예요?"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "一%1$@，究竟是甚麼？"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1 %1$@ คืออะไรกันแน่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tam olarak nedir?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czym właściwie jest jednostka?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad er en genstand egentlig?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu %1$@ itu sebenarnya apa?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa sebenarnya satu %1$@?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano ba talaga ang isang %1$@?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một %1$@ thực ra là gì?"
          }
        }
      }
    },
