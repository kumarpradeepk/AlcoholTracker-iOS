    "icon_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same app, different coat. Pick whichever suits your Home Screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Same app, different coat. Pick whichever suits your Home Screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche App, anderes Kleid. Nimm, was zu deinem Startbildschirm passt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じアプリ、違う装い。ホーム画面に合うものを選んでください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même app, autre habit. Choisissez celle qui va à votre écran d'accueil."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Même application, autre habit. Choisis celle qui va avec ton écran d'accueil."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma app, otro traje. Elige la que combine con tu pantalla de inicio."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma app con otro traje. Elige el que mejor le siente a tu pantalla de inicio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo app, outra roupa. Escolha a que combina com a sua tela de início."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stessa app, vestito diverso. Scegli quello che sta meglio nella tua schermata Home."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 앱, 다른 옷. 홈 화면에 어울리는 걸로 고르세요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "同一個 App，換件外衣。揀個配襯你主畫面的。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปเดิม เปลี่ยนเสื้อ เลือกอันที่เข้ากับหน้าจอโฮมของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı uygulama, farklı bir kılık. Ana Ekranınıza hangisi yakışıyorsa onu seçin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta sama aplikacja, inny płaszcz. Wybierz tę, która pasuje do ekranu głównego."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samme app, ny frakke. Vælg den, der passer til din hjemmeskærm."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi yang sama, mantel berbeda. Pilih yang cocok dengan Layar Utamamu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi yang sama, kot yang berbeza. Pilih mana-mana yang sesuai dengan Skrin Utama anda."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Parehong app, ibang balat. Piliin kung alin ang bagay sa Home Screen mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn ứng dụng đó, khoác áo khác. Chọn kiểu hợp với Màn hình chính của bạn."
          }
        }
      }
    },
