          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koszty pojawią się po zapisaniu drinka z ceną."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udgifter dukker op, når du noterer en drink med pris."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
