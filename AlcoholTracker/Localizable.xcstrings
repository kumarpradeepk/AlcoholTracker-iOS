    "stats_saved_over": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%1$@ over your typical spend this period."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%1$@ over your typical spend this period."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ über deinen typischen Ausgaben in diesem Zeitraum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間は、ふだんの支出より%2$@%1$@多くなりました。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ de plus que vos dépenses habituelles sur cette période."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ de plus que ta dépense habituelle pour cette période."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%1$@ más que tu gasto típico en este período."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ por encima de tu gasto habitual en este periodo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@ acima do seu gasto habitual neste período."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ in più rispetto alla tua spesa tipica in questo periodo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 기간, 평소 지출보다 %2$@%1$@ 많아요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "今期比平常花費多 %2$@%1$@。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงนี้สูงกว่ายอดที่ปกติใช้อยู่ %2$@%1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dönemde her zamanki harcamanızın %1$@ %2$@ üstünde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ powyżej typowego wydatku w tym okresie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ over dit typiske forbrug i perioden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@ di atas pengeluaran biasamu periode ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%1$@ melebihi perbelanjaan biasa anda tempoh ini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas mataas nang %2$@%1$@ sa karaniwang gastos mo ngayong panahon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kỳ này nhiều hơn mức chi tiêu điển hình %1$@ %2$@."
          }
        }
      }
    },
    "stats_saved_under": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%1$@ under your typical spend this period, based on what you actually pay, not averages."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%1$@ under your typical spend this period, based on what you actually pay, not averages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ unter deinen typischen Ausgaben in diesem Zeitraum, berechnet aus dem, was du wirklich zahlst, nicht aus Durchschnitten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間は、ふだんの支出より%2$@%1$@少なくすみました。平均ではなく、あなたが実際に払っている金額をもとにしています。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ de moins que vos dépenses habituelles sur cette période, calculé sur ce que vous payez vraiment, pas sur des moyennes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ de moins que ta dépense habituelle pour cette période, d'après ce que tu paies vraiment, pas d'après des moyennes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%1$@ menos que tu gasto típico en este período, según lo que pagas de verdad, no promedios."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ por debajo de tu gasto habitual en este periodo, según lo que pagas de verdad, no según medias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@ abaixo do seu gasto habitual neste período, com base no que você realmente paga, não em médias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ in meno rispetto alla tua spesa tipica in questo periodo, sui prezzi che paghi davvero, non su medie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 기간, 평소 지출보다 %2$@%1$@ 적어요. 평균이 아니라 실제로 낸 가격 기준이에요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "今期比平常花費少 %2$@%1$@，根據你真正付的價錢，不是平均數。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงนี้ต่ำกว่ายอดที่ปกติใช้อยู่ %2$@%1$@ คิดจากราคาที่คุณจ่ายจริง ไม่ใช่ค่าเฉลี่ย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dönemde her zamanki harcamanızın %1$@ %2$@ altında — ortalamalara değil, gerçekten ödediğinize göre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ poniżej typowego wydatku w tym okresie — na podstawie tego, co naprawdę płacisz, nie średnich."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ under dit typiske forbrug i perioden — ud fra det, du faktisk betaler, ikke gennemsnit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ %1$@ di bawah pengeluaran biasamu periode ini, berdasarkan yang kamu bayar sungguhan, bukan rata-rata."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%1$@ di bawah perbelanjaan biasa anda tempoh ini, berdasarkan apa yang anda benar-benar bayar, bukan purata."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas mababa nang %2$@%1$@ sa karaniwang gastos mo ngayong panahon, batay sa totoong binabayaran mo, hindi sa average."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kỳ này ít hơn mức chi tiêu điển hình %1$@ %2$@, tính từ số tiền thực trả chứ không phải mức trung bình."
          }
        }
      }
    },
    "stats_saved_unset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your typical weekly spend and this becomes money saved, from your real prices, not national averages."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your typical weekly spend and this becomes money saved, from your real prices, not national averages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag deine typischen Wochenausgaben ein, und daraus wird gespartes Geld, aus deinen echten Preisen, nicht aus Durchschnittswerten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふだんの1週間の支出を入れると、ここが浮いたお金になります。全国平均ではなく、あなたが実際に払った金額から計算します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez vos dépenses hebdomadaires habituelles et ceci devient de l'argent économisé, à partir de vos vrais prix, pas de moyennes nationales."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique ce que tu dépenses dans une semaine ordinaire et ça devient de l'argent épargné, calculé sur tes vrais prix, pas sur des moyennes nationales."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica cuánto gastas en una semana típica y esto se convierte en dinero ahorrado, con tus precios reales, no con promedios nacionales."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica lo que sueles gastar en una semana y esto se convertirá en dinero ahorrado, a partir de tus precios reales, no de medias nacionales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe quanto costuma gastar por semana e isto vira dinheiro economizado, a partir dos seus preços reais, não de médias nacionais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la tua spesa settimanale tipica e qui comparirà il risparmio, calcolato sui tuoi prezzi reali, non su medie nazionali."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 일주일 지출을 넣으면, 국가 평균이 아니라 내가 실제로 낸 가격으로 아낀 돈이 계산돼요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "填上你平常一星期的花費，這裏就會變成省下的錢——用你真正付的價錢，不是甚麼平均數。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ยอดที่ปกติใช้ต่อสัปดาห์ แล้วตรงนี้จะกลายเป็นเงินที่ประหยัดได้ คิดจากราคาที่คุณจ่ายจริง ไม่ใช่ค่าเฉลี่ยของประเทศ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zamanki haftalık harcamanızı girin; buradaki rakam gerçek fiyatlarınızdan hesaplanan tasarrufa dönüşsün — ülke ortalamalarından değil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj typowy tygodniowy wydatek, a to zamieni się w oszczędności — z twoich realnych cen, nie ze średnich krajowych."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv, hvad du typisk bruger på en uge, så bliver det her til penge sparet — ud fra dine egne priser, ikke landsgennemsnit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi pengeluaran mingguanmu yang biasa, dan ini berubah jadi uang yang dihemat, dari harga yang kamu bayar sungguhan, bukan rata-rata nasional."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan perbelanjaan mingguan biasa anda dan ini menjadi wang yang dijimatkan, daripada harga sebenar anda, bukan purata kebangsaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itakda ang karaniwang lingguhang gastos mo at magiging naipong pera ito, mula sa totoong presyong binabayaran mo, hindi sa pambansang average."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mức chi tiêu một tuần điển hình, chỗ này sẽ thành tiền tiết kiệm, tính từ giá thật của bạn chứ không phải mức trung bình cả nước."
          }
        }
      }
    },
