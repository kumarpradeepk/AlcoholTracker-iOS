    "trends_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The curve settles as your body clears roughly 0.015% an hour. Flat weeks are good weeks."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The curve settles as your body clears roughly 0.015% an hour. Flat weeks are good weeks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kurve sinkt, weil dein Körper etwa 0,015 % pro Stunde abbaut. Flache Wochen sind gute Wochen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体が1時間におよそ0.015%を分解するので、曲線は下がっていきます。平らな週は、良い週です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La courbe redescend à mesure que votre organisme élimine environ 0,015 % par heure. Les semaines plates sont de bonnes semaines."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La courbe redescend à mesure que ton organisme élimine environ 0,015 % à l'heure. Les semaines plates sont de bonnes semaines."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La curva baja a medida que tu organismo elimina cerca de 0.015 % por hora. Las semanas planas son buenas semanas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La curva baja a medida que tu cuerpo elimina en torno a un 0,015 % por hora. Las semanas planas son semanas buenas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A curva baixa conforme seu corpo elimina cerca de 0,015% por hora. Semanas planas são boas semanas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La curva scende mentre il corpo elimina circa lo 0,015% all'ora. Le settimane piatte sono settimane buone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸이 시간당 대략 0.015%씩 분해하면서 곡선이 내려가요. 평평한 주가 좋은 주예요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "身體大約每小時代謝 0.015%，曲線就這樣回落。平坦的一個星期，就是好的一個星期。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นจะค่อยๆ ลดลงตามที่ร่างกายกำจัดออกราว 0.015% ต่อชั่วโมง สัปดาห์ที่เส้นราบคือสัปดาห์ที่ดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücudunuz saatte kabaca %0,015 temizledikçe eğri düşer. Düz haftalar iyi haftalardır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krzywa opada, bo organizm usuwa mniej więcej 0,015 % na godzinę. Płaskie tygodnie to dobre tygodnie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurven falder, fordi kroppen forbrænder omkring 0,015 % i timen. Flade uger er gode uger."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurvanya turun selagi tubuh menguraikan kira-kira 0,015% per jam. Minggu yang datar adalah minggu yang baik."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengkung itu menurun apabila badan anda menghapuskan kira-kira 0.015% sejam. Minggu yang rata ialah minggu yang baik."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumababa ang kurba habang naaalis ng katawan mo ang mga 0.015% kada oras. Mabuti ang mga linggong patag."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đường cong hạ xuống khi cơ thể đào thải khoảng 0,015% mỗi giờ. Những tuần phẳng là những tuần lành."
          }
        }
      }
    },
