        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าใช้จ่ายจะขึ้นเมื่อคุณจดแก้วที่ใส่ราคาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
