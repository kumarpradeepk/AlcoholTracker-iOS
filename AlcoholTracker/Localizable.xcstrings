          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcoholemia estimada, tiempo hasta cero y la tarjeta de estado persistente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimativa de álcool no sangue, tempo até zerar e o cartão de status contínuo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasso alcolemico stimato, tempo a zero e la scheda di stato persistente."
