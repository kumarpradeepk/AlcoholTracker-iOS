          "stringUnit": {
            "state": "translated",
            "value": "どちらもいつでも変えられます。推定値はすぐに合わせ直します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiable à tout moment, les estimations suivent aussitôt."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux changer l'un ou l'autre en tout temps, les estimations s'ajustent aussitôt."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarlos cuando quieras; las estimaciones se ajustan al instante."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar cualquiera de los dos cuando quieras; las estimaciones se ajustan al instante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude qualquer um a qualquer momento; as estimativas se ajustam na hora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiarli quando vuoi, le stime si aggiornano subito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 언제든 바꿀 수 있고, 추정치는 바로 반영돼요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "兩項隨時可改，估算值即時跟着調整。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนทั้งสองอย่างได้ตลอด ค่าประมาณจะปรับตามทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkisini de istediğiniz zaman değiştirebilirsiniz; tahminler anında güncellenir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno i drugie można zmienić w każdej chwili — szacunki od razu się dostosują."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift begge dele når som helst — estimaterne justerer sig med det samme."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keduanya bisa diubah kapan saja, perkiraannya menyesuaikan seketika."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah mana-mana bila-bila masa, anggaran melaras serta-merta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwedeng baguhin ang alinman anumang oras, agad na nag-a-adjust ang mga tantiya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể đổi cả hai bất cứ lúc nào, ước tính điều chỉnh ngay lập tức."
          }
        }
      }
    },
    "profile_headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body, your numbers."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body, your numbers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Körper, deine Zahlen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの体、あなたの数字。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps, vos chiffres."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton corps, tes chiffres."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo, tus números."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo, tus números."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu corpo, seus números."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo corpo, i tuoi numeri."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 몸, 내 숫자."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的身體，你的數字。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ร่างกายของคุณ ตัวเลขของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin vücudunuz, sizin sayılarınız."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje ciało, twoje liczby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din krop, dine tal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tubuhmu, angkamu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Badan anda, nombor anda."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang katawan mo, ang mga numero mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cơ thể của bạn, con số của bạn."
          }
        }
      }
    },
    "profile_privacy_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten seconds, once. Nothing here ever leaves this phone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten seconds, once. Nothing here ever leaves this phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zehn Sekunden, einmalig. Nichts davon verlässt je dieses Handy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "十秒、一度きり。ここに入れたものが、この端末を離れることはありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dix secondes, une seule fois. Rien de tout cela ne quitte ce téléphone."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Dix secondes, une seule fois. Rien de tout ça ne quitte jamais ce téléphone."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Diez segundos, una sola vez. Nada de esto sale de este celular."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Diez segundos, una sola vez. Nada de esto sale nunca de este móvil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez segundos, uma vez só. Nada daqui sai deste celular."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieci secondi, una volta sola. Niente di tutto questo lascia mai il telefono."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10초면 끝, 한 번이면 돼요. 여기 있는 건 이 휴대폰을 떠나지 않아요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "十秒鐘，一次就夠。這裏的一切，從不離開這部手機。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิบวินาที ครั้งเดียว ทุกอย่างตรงนี้ไม่เคยออกจากเครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez, on saniye. Buradaki hiçbir şey bu telefondan çıkmaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziesięć sekund, raz. Nic stąd nigdy nie opuszcza tego telefonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti sekunder, én gang. Intet herfra forlader nogensinde telefonen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepuluh detik, sekali saja. Tidak ada yang keluar dari ponsel ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepuluh saat, sekali sahaja. Tiada apa-apa di sini meninggalkan telefon ini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampung segundo, minsan lang. Walang anuman dito ang lalabas ng phone na ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mười giây, một lần duy nhất. Không gì ở đây rời khỏi điện thoại này."
          }
        }
      }
    },
