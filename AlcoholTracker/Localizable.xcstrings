    "sheet_health_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logged drinks can be saved automatically to %1$@, so your whole picture lives in one place."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Logged drinks can be saved automatically to %1$@, so your whole picture lives in one place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasste Getränke können automatisch in %1$@ gespeichert werden, damit dein ganzes Bild an einem Ort liegt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録したお酒は%1$@に自動で保存できます。全体像がひとつの場所にまとまります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les verres enregistrés peuvent être envoyés automatiquement vers %1$@, pour que tout votre tableau tienne au même endroit."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les verres inscrits peuvent être enregistrés automatiquement dans %1$@, pour que tout ton portrait vive au même endroit."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tragos que anotes pueden guardarse automáticamente en %1$@, para que todo tu panorama esté en un solo lugar."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que registres puede guardarse automáticamente en %1$@, para que tengas la imagen completa en un solo sitio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As bebidas registradas podem ser salvas automaticamente no %1$@, para o seu quadro inteiro ficar em um lugar só."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bevande registrate possono essere salvate automaticamente su %1$@, così il quadro completo sta in un posto solo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록한 잔을 %1$@에 자동으로 저장할 수 있어요. 전체 그림이 한곳에 모여요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "記下的每一杯，可以自動存到 %1$@，整幅圖就集中在一個地方。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้วที่จดไว้จะถูกบันทึกไปยัง %1$@ โดยอัตโนมัติ ภาพทั้งหมดจึงอยู่ที่เดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğiniz içkiler otomatik olarak %1$@ hizmetine yazılabilir; böylece tablonun tamamı tek yerde durur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane drinki mogą trafiać automatycznie do %1$@, żeby cały obraz był w jednym miejscu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noterede drinks kan gemmes automatisk i %1$@, så hele billedet samles ét sted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuman yang dicatat bisa otomatis tersimpan ke %1$@, supaya gambaran utuhnya ada di satu tempat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuman yang dicatat boleh disimpan secara automatik ke %1$@, supaya keseluruhan gambaran anda berada di satu tempat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Awtomatikong maisi-save sa %1$@ ang mga na-log na inom, para nasa iisang lugar ang buong larawan mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồ uống đã ghi có thể tự động lưu sang %1$@, để toàn bộ bức tranh nằm ở một nơi."
          }
        }
      }
    },
