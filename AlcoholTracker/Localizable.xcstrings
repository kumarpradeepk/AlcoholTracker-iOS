          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟีเจอร์ Pro ทั้งหมดเป็นของคุณ %1$d วัน ยกเลิกก่อนหมดเมื่อไรก็ได้ แล้วจะไม่มีการเรียกเก็บเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm Pro özellikleri %1$d gün boyunca senin. Bitmeden istediğin an iptal et, hiçbir ücret alınmaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie funkcje Pro są twoje przez %1$d dni. Anuluj przed końcem, a nic nie zostanie pobrane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Pro-funktioner er dine i %1$d dage. Afmeld når som helst inden den slutter, så bliver der ikke trukket noget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua fitur Pro jadi milikmu selama %1$d hari. Batalkan kapan pun sebelum berakhir dan tidak ada yang ditagih."
