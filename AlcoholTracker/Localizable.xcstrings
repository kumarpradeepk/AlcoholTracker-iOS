    "bac_setup_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your weight and sex so estimates actually mean something, it takes ten seconds."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your weight and sex so estimates actually mean something, it takes ten seconds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag Gewicht und Geschlecht ein, damit die Schätzwerte überhaupt etwas aussagen, das dauert zehn Sekunden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重と性別を入れると、推定値がはじめて意味を持ちます。十秒で終わります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez votre poids et votre sexe pour que les estimations veuillent vraiment dire quelque chose, dix secondes suffisent."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ton poids et ton sexe pour que les estimations veuillent dire quelque chose. Dix secondes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica tu peso y tu sexo para que las estimaciones signifiquen algo de verdad; toma diez segundos."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu peso y tu sexo para que las estimaciones signifiquen algo de verdad; son diez segundos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe seu peso e sexo para que as estimativas signifiquem alguma coisa. Leva dez segundos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi peso e sesso: senza, le stime non vogliono dire granché. Dieci secondi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중과 성별을 넣으면 추정치가 실제로 의미를 갖게 돼요. 10초면 충분해요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "填上體重和性別，估算值才真正有意思，十秒就夠。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่น้ำหนักกับเพศ ค่าประมาณจึงจะมีความหมายจริงๆ ใช้เวลาสิบวินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahminlerin gerçekten bir anlam taşıması için ağırlığınızı ve cinsiyetinizi ekleyin; on saniye sürer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj masę ciała i płeć, żeby szacunki naprawdę coś znaczyły — to dziesięć sekund."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj vægt og køn, så estimaterne rent faktisk betyder noget. Det tager ti sekunder."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan berat badan dan jenis kelamin supaya perkiraannya berarti, cukup sepuluh detik."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan berat dan jantina anda supaya anggaran ini benar-benar bermakna, sepuluh saat sahaja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang timbang at kasarian mo para may saysay ang mga tantiya, sampung segundo lang ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm cân nặng và giới tính sinh học để ước tính có ý nghĩa, chỉ mất mười giây."
          }
        }
      }
    },
