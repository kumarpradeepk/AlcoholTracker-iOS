    "notif_discreet_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ten-second note keeps the picture honest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A ten-second note keeps the picture honest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Notiz in zehn Sekunden hält das Bild ehrlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "十秒のメモで、全体像は正直なままです。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une note de dix secondes garde le tableau honnête."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une note de dix secondes garde le portrait honnête."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nota de diez segundos mantiene el panorama honesto."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Diez segundos de anotación y la imagen sigue siendo honesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nota de dez segundos mantém o quadro honesto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieci secondi di appunti tengono onesto il quadro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10초만 적어도 그림이 정직해져요."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "十秒鐘寫一筆，整幅圖就誠實。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดสิบวินาที ภาพก็ตรงตามจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "On saniyelik bir not, tabloyu dürüst tutar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziesięć sekund notatki wystarczy, żeby obraz był uczciwy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti sekunders notat holder billedet ærligt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan sepuluh detik menjaga gambarannya tetap jujur."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota sepuluh saat mengekalkan gambaran yang jujur."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinapanatiling tapat ng sampung segundong tala ang larawan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ghi chú mười giây giữ cho bức tranh trung thực."
          }
        }
      }
    },
