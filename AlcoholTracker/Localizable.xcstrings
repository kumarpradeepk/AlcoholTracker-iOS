        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dziennik świadomego picia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din følgesvend til et bevidst alkoholforbrug."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teman untuk minum dengan sadar takaran."
