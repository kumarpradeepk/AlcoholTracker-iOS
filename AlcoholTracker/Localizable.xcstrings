    "set_bac_row_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated BAC, time to zero, and the ongoing status card."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
